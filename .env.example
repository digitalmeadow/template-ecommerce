# Copy to .env at the repo root (gitignored). Every package symlinks its own .env to it
# (frontend, frontend-nextjs, cms, sanity, sanity-nextjs, shopify), so one file drives them all.
# In CI none of this is read: values come from the deploy workflow and GitHub secrets.

# --- Site --------------------------------------------------------------------
# Drives `site` in astro.config: canonicals, sitemap, robots and JSON-LD @ids.
WEBSITE_URL=http://localhost:3001
# "true" builds SSR against drafts (the *-preview workers); "false" is a static published build.
PREVIEW=false

# --- Sanity ------------------------------------------------------------------
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Server-only. The dataset is private; never expose these to the browser.
SANITY_VIEWER_API_TOKEN=
SANITY_EDITOR_API_TOKEN=
SANITY_WEBHOOK_SECRET=

# --- Deploy (api worker) -----------------------------------------------------
GIT_API_TOKEN=
GIT_BRANCH=main
# Environment the api worker's /api/deploy dispatches: all | production | production-preview | staging
DEPLOY_ENVIRONMENT=all

# --- Shopify -----------------------------------------------------------------
SHOPIFY_PRIVATE_API_TOKEN=

# --- Studio ------------------------------------------------------------------
# Sanity only exposes the SANITY_STUDIO_ prefix to the Studio bundle, hence the duplicated id.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_APP_ID=
SANITY_STUDIO_TITLE=template-ecommerce
SANITY_STUDIO_PREVIEW_URL=https://template-ecommerce-production-preview.digital-meadow.workers.dev
