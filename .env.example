# Local only: every package's .env symlinks here. Deployed builds use DEPLOY_ENVIRONMENTS in
# frontend/config.ts and each Worker's build variables instead.

WEBSITE_URL=http://localhost:3000
# "true" builds SSR against drafts, like the production-preview Worker.
PREVIEW=false

SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_VIEWER_API_TOKEN=
SANITY_EDITOR_API_TOKEN=

SHOPIFY_PRIVATE_API_TOKEN=
SHOPIFY_SANITY_SYNC_SECRET=

# The Studio bundle only sees the SANITY_STUDIO_ prefix.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_APP_ID=
SANITY_STUDIO_TITLE=template-ecommerce
SANITY_STUDIO_PREVIEW_URL=https://template-ecommerce-production-preview.digital-meadow.workers.dev
