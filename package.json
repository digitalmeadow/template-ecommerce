{
  "name": "template-ecommerce",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm run --parallel -r dev",
    "build": "pnpm run --parallel -r build",
    "preview": "pnpm run --parallel -r preview",
    "lint": "pnpm run --parallel -r lint",
    "typecheck": "pnpm run --parallel -r typecheck",
    "gen": "pnpm --filter cms gen && pnpm --filter sanity gen && pnpm --filter sanity-nextjs gen && pnpm --filter shopify gen"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
