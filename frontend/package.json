{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --port 3001",
    "build": "astro build",
    "preview": "npx astro build && npx wrangler dev",
    "deploy": "npx astro build && npx wrangler deploy",
    "astro": "astro",
    "lint": "eslint .",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.4",
    "@astrojs/sitemap": "3.7.3",
    "@mux/blurup": "1.0.2",
    "@mux/mux-player": "3.13.2",
    "@nanostores/persistent": "1.3.5",
    "astro": "7.1.3",
    "astro-portabletext": "0.13.0",
    "embla-carousel": "8.6.0",
    "graphql-request": "7.4.0",
    "nanostores": "1.4.1",
    "octokit": "5.0.5",
    "sanity": "workspace:*",
    "shopify": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@eslint/js": "10.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-astro": "1.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "wrangler": "4.114.0"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "semi": true,
    "printWidth": 100,
    "bracketSpacing": true,
    "singleQuote": false
  }
}
