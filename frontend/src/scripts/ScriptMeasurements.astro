<script is:inline>
  const setDimensions = () => {
    const root = document.documentElement;
    const vw = root.clientWidth / 100;
    root.style.setProperty("--vw", `${vw}px`);

    // Anchors clear the sticky header by its real height.
    const header = document.querySelector("[data-header]");
    if (header) root.style.setProperty("--scroll-padding-top", `${header.offsetHeight}px`);
  };

  setDimensions();
  window.addEventListener("resize", setDimensions);
  window.addEventListener("DOMContentLoaded", () => {
    setDimensions();
    // The header persists across navigations, so one observer covers wrapping nav and font swaps.
    const header = document.querySelector("[data-header]");
    if (header) new ResizeObserver(setDimensions).observe(header);
  });
  // Router resets <html> attributes on swap, before page-load.
  document.addEventListener("astro:after-swap", setDimensions);
  document.addEventListener("astro:page-load", setDimensions);
</script>
