---
import PageLayout from "@layouts/PageLayout.astro";
import SectionsRenderer from "@sections/SectionsRenderer.astro";
import { propsForSlug } from "@lib/sanity/staticPaths";
import { buildPagePaths } from "@lib/sanity/paths";
import { resolveMeta } from "@lib/sanity/meta";
import { buildBreadcrumbSchema } from "@lib/sanity/structuredData";

export async function getStaticPaths() {
  return buildPagePaths();
}

// Empty in server output (the preview site), where Astro skips getStaticPaths.
const resolved = await propsForSlug(Astro.props, Astro.params.slug, buildPagePaths);
if (!resolved) return Astro.rewrite("/404");

const { pageData } = resolved;

// Every page needs an h1; the hero section provides one when present.
const hasHeroHeading = pageData.sections?.some(
  (section) => section?.__typename === "SectionHero" && section.heading,
);
---

<PageLayout
  metaData={resolveMeta(pageData)}
  jsonLd={[buildBreadcrumbSchema(Astro.url.pathname, pageData.title, Astro.site)]}
>
  {!hasHeroHeading && pageData.title && <h1 class="visually-hidden">{pageData.title}</h1>}
  <SectionsRenderer sections={pageData.sections} />
</PageLayout>
