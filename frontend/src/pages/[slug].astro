---
import PageLayout from "@layouts/PageLayout.astro";
import SectionsRenderer from "@sections/SectionsRenderer.astro";
import { propsForSlug } from "@lib/sanity/staticPaths";
import { buildPagePaths, loadPageProps } from "@lib/sanity/paths";
import { resolveMeta } from "@lib/sanity/meta";
import { buildBreadcrumbSchema } from "@lib/sanity/structuredData";
import { hasHeroHeading } from "@lib/sanity/sections";
import { getRenderLocale } from "@lib/shopify/locale";

export async function getStaticPaths() {
  return buildPagePaths();
}

const resolved = await propsForSlug(Astro.props, Astro.params.slug, loadPageProps);
if (!resolved) return Astro.rewrite("/404");

const { pageData } = resolved;
---

<PageLayout
  metaData={resolveMeta(pageData)}
  jsonLd={[
    buildBreadcrumbSchema(Astro.url.pathname, pageData.title, Astro.site, getRenderLocale(Astro)),
  ]}
>
  {!hasHeroHeading(pageData.sections) && pageData.title && (
    <h1 class="g-sr-only">{pageData.title}</h1>
  )}
  <SectionsRenderer sections={pageData.sections} />
</PageLayout>
