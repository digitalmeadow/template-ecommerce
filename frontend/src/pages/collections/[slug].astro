---
import { sanityClient } from "sanity/client";
import PageLayout from "@layouts/PageLayout.astro";
import { collectionsQuery } from "sanity/queries/collection";
import { fetchCollectionShopifySanity } from "@lib/fetches/collectionShopifySanity";
import SectionHero from "@sections/SectionHero.astro";
import ProductThumbnailsGrid from "@sections/product/ProductThumbnailsGrid.astro";
import type { MetaFragment } from "sanity/generated/graphql";

export async function getStaticPaths() {
  const collectionsQueryResult = await sanityClient.request(collectionsQuery);
  const slugs = collectionsQueryResult.allCollection.map(
    (collection) => collection.shopify?.handle?.current,
  );
  return slugs.map((slug) => (slug ? { params: { slug } } : null));
}

let { slug } = Astro.params;
const collectionData = await fetchCollectionShopifySanity(slug);

// Meta fallbacks
const metaData: MetaFragment = {
  __typename: "Meta",
  title: collectionData.sanity.meta?.title || collectionData.shopify.title,
  description: collectionData.sanity.meta?.description ?? null,
  image: collectionData.sanity.meta?.image ?? null,
};
---

<PageLayout metaData={metaData}>
  <SectionHero
    section={{
      __typename: "SectionHero",
      _key: null,
      heading: collectionData.shopify.title,
      textRaw: null,
      backgroundMedia: null,
    }}
  />

  <ProductThumbnailsGrid productsData={collectionData.productThumbnails} />
</PageLayout>

<style>
  .grid {
    width: var(--container-width);
    margin: 0 auto;

    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gutter);
    margin-top: var(--s40);
  }
  @media (max-width: 500px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
