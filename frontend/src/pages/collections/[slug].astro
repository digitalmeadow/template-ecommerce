---
import PageLayout from "@layouts/PageLayout.astro";
import { fetchCollectionShopifySanity } from "@lib/fetches/collectionShopifySanity";
import SectionHero from "@sections/SectionHero.astro";
import ProductThumbnailsGrid from "@sections/product/ProductThumbnailsGrid.astro";
import { propsForSlug } from "@lib/sanity/staticPaths";
import { buildCollectionPaths, loadCollectionProps } from "@lib/sanity/paths";
import { resolveMeta } from "@lib/sanity/meta";
import { buildBreadcrumbSchema } from "@lib/sanity/structuredData";

export async function getStaticPaths() {
  return buildCollectionPaths();
}

const resolved = await propsForSlug(Astro.props, Astro.params.slug, loadCollectionProps);
if (!resolved || !Astro.params.slug) return Astro.rewrite("/404");

const collectionData = await fetchCollectionShopifySanity(
  Astro.params.slug,
  resolved.sanityCollectionData,
);
---

<PageLayout
  metaData={resolveMeta(collectionData.sanity, { title: collectionData.shopify.title })}
  jsonLd={[buildBreadcrumbSchema(Astro.url.pathname, collectionData.shopify.title, Astro.site)]}
>
  <SectionHero
    section={{
      __typename: "SectionHero",
      _key: null,
      colorScheme: null,
      id: null,
      heading: collectionData.shopify.title,
      textRaw: null,
      mediaBackground: null,
    }}
  />

  <ProductThumbnailsGrid productsData={collectionData.productThumbnails} />
</PageLayout>
