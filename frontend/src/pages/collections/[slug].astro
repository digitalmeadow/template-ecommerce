---
import PageLayout from "@layouts/PageLayout.astro";
import { fetchCollectionShopifySanity } from "@lib/fetches/collectionShopifySanity";
import { resolveMeta } from "@lib/sanity/meta";
import { buildCollectionPaths, loadCollectionProps } from "@lib/sanity/paths";
import { propsForSlug } from "@lib/sanity/staticPaths";
import { buildBreadcrumbSchema } from "@lib/sanity/structuredData";
import { getRenderLocale } from "@lib/shopify/locale";
import ProductBrowser from "@sections/product/ProductBrowser.astro";
import SectionHero from "@sections/SectionHero.astro";

export async function getStaticPaths() {
  return buildCollectionPaths();
}

const resolved = await propsForSlug(Astro.props, Astro.params.slug, loadCollectionProps);
if (!resolved || !Astro.params.slug) return Astro.rewrite("/404");

const locale = getRenderLocale(Astro);
const collection = await fetchCollectionShopifySanity(
  Astro.params.slug,
  locale,
  resolved.sanityCollection,
);
---

<PageLayout
  meta={resolveMeta(collection.sanity, { title: collection.shopify.title })}
  jsonLd={[buildBreadcrumbSchema(Astro.url.pathname, collection.shopify.title, Astro.site, locale)]}
>
  <SectionHero
    section={{
      __typename: "SectionHero",
      _key: null,
      colorScheme: null,
      id: null,
      heading: collection.shopify.title,
      textRaw: null,
      mediaBackground: null,
    }}
  />

  <div class="g-page-margin g-section-sm">
    <ProductBrowser
      source={{ type: "collection", handle: collection.shopify.handle }}
      collectionId={collection.shopify.id}
      results={{
        products: collection.productThumbnails,
        filters: collection.shopify.products.filters,
        hasNextPage: collection.shopify.products.pageInfo.hasNextPage,
        endCursor: collection.shopify.products.pageInfo.endCursor ?? null,
      }}
      params={new URLSearchParams()}
    />
  </div>
</PageLayout>
