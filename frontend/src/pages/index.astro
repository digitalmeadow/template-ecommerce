---
import { sanityClient } from "sanity/client";
import { homeQuery } from "sanity/queries/home";
import PageLayout from "@layouts/PageLayout.astro";
import { getGlobals } from "@lib/sanity/globals";
import { resolveMeta } from "@lib/sanity/meta";
import { hasHeroHeading } from "@lib/sanity/sections";
import SectionsRenderer from "@sections/SectionsRenderer.astro";

const homeQueryResult = await sanityClient.request(homeQuery);
const page = homeQueryResult.allHome[0];
const { organisationSettings } = await getGlobals();
---

<PageLayout meta={resolveMeta(page)}>
  {!hasHeroHeading(page?.sections) && organisationSettings?.name && (
    <h1 class="g-sr-only">{organisationSettings.name}</h1>
  )}
  <SectionsRenderer sections={page?.sections} />
</PageLayout>
