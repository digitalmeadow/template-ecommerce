---
import PageLayout from "@layouts/PageLayout.astro";
import { fetchProductShopifySanity } from "@lib/fetches/productShopifySanity";
import ProductSection from "@sections/product/ProductSection.astro";
import RelatedProductsSection from "@sections/product/RelatedProductsSection.astro";
import { propsForSlug } from "@lib/sanity/staticPaths";
import { buildProductPaths, loadProductProps } from "@lib/sanity/paths";
import { resolveMeta } from "@lib/sanity/meta";
import { buildBreadcrumbSchema, buildProductSchema } from "@lib/sanity/structuredData";

export async function getStaticPaths() {
  return buildProductPaths();
}

// Empty in server output (the preview site), where Astro skips getStaticPaths.
const resolved = await propsForSlug(Astro.props, Astro.params.slug, loadProductProps);
if (!resolved || !Astro.params.slug) return Astro.rewrite("/404");

const productData = await fetchProductShopifySanity(Astro.params.slug, resolved.sanityProductData);

const metaData = resolveMeta(productData.sanity, { title: productData.shopify.title });
---

<PageLayout
  metaData={metaData}
  ogType="product"
  jsonLd={[
    buildProductSchema(productData, metaData.description, Astro.site),
    buildBreadcrumbSchema(Astro.url.pathname, productData.shopify.title, Astro.site),
  ]}
>
  <ProductSection productData={productData} />
  <RelatedProductsSection productsData={productData.relatedProducts} />
</PageLayout>
