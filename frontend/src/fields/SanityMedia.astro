---
import type { MediaFragment } from "sanity/generated/graphql";
import MuxVideo from "@fields/MuxVideo.astro";
import SanityImage from "@fields/SanityImage.astro";
import VimeoVideo from "@fields/VimeoVideo.astro";

interface Props {
  media: MediaFragment | null | undefined;
  layout?: "width" | "height" | "cover" | "contain";
  sizes?: [number, number, number];
  loading?: "lazy" | "eager";
}

const { media, layout = "width", sizes = [100, 100, 100], loading = "lazy" }: Props = Astro.props;
---

{media?.type === "image" && (
  <SanityImage image={media.image} layout={layout} sizes={sizes} loading={loading} />
)}
{media?.type === "video" && <MuxVideo video={media.video} layout={layout} loading={loading} />}
{media?.type === "vimeo" && <VimeoVideo video={media.vimeo} layout={layout} loading={loading} />}
