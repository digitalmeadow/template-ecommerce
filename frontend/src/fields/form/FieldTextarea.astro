---
interface Props {
  id: string;
  name: string;
  label: string;
  placeholder: string;
  required: boolean;
  errorId?: string;
}

const { id, name, label, placeholder, required, errorId }: Props = Astro.props;
---

<label class="visually-hidden" for={id}>
  {label}
</label>
<textarea
  id={id}
  name={name}
  placeholder={placeholder}
  required={required}
  aria-describedby={errorId}
  rows="4"
></textarea>

<style>
  textarea {
    padding: var(--s20) 0;
    cursor: text;
    resize: vertical;
  }

  textarea:focus-visible {
    outline: none;
  }
</style>
