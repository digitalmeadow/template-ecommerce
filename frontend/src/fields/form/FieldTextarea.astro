---
interface Props {
  id: string;
  name: string;
  placeholder: string;
  required: boolean;
  errorId: string;
}

const { id, name, placeholder, required, errorId }: Props = Astro.props;
---

<textarea
  id={id}
  name={name}
  placeholder={placeholder}
  required={required}
  aria-describedby={errorId}
  rows="4"
></textarea>
