---
interface Props {
  id: string;
  name: string;
  type: "text" | "email" | "tel";
  placeholder: string;
  required: boolean;
  errorId: string;
  autocomplete?: string;
}

const { id, name, type, placeholder, required, errorId, autocomplete }: Props = Astro.props;
---

<input
  id={id}
  name={name}
  type={type}
  placeholder={placeholder}
  required={required}
  autocomplete={autocomplete}
  aria-describedby={errorId}
/>
