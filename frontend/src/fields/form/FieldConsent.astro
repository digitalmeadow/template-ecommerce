---
import PortableText from "@fields/PortableText.astro";
import { CONSENT_VALUE } from "@lib/forms/constants";

interface Props {
  id: string;
  name: string;
  label: string;
  required: boolean;
  statement: unknown;
  errorId: string;
}

const { id, name, label, required, statement, errorId }: Props = Astro.props;

const statementId = `${id}-statement`;
---

<div class="g-form-choice">
  {/* Not wrapped in a <label>: the statement is block content with links of its own. */}
  <input
    type="checkbox"
    id={id}
    name={name}
    value={CONSENT_VALUE}
    required={required}
    aria-label={label}
    aria-describedby={`${statementId} ${errorId}`}
  />
  <div class="g-text-small" id={statementId}>
    <PortableText value={statement} />
  </div>
</div>
