---
import { ACCEPTED_FILE_ATTR } from "@lib/forms/constants";

interface Props {
  id: string;
  name: string;
  placeholder: string;
  required: boolean;
  multiple: boolean;
  errorId: string;
}

const { id, name, placeholder, required, multiple, errorId }: Props = Astro.props;
---

<input
  class="file-input g-sr-only"
  id={id}
  name={name}
  type="file"
  accept={ACCEPTED_FILE_ATTR}
  required={required}
  multiple={multiple}
  aria-describedby={errorId}
/>
<label class="file-label" for={id} aria-hidden="true">
  <span class="file-name" data-file-label={placeholder}>
    {placeholder}
  </span>
  <span>↑</span>
</label>

<style>
  /* Drawn like the other controls (globals/forms.css); the native input is hidden behind it. */
  .file-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--size-2-5);
    min-height: 2.5rem;
    padding: 0 var(--size-2-5);
    background-color: var(--color-surface);
    border-bottom: var(--border-width-1) solid var(--color-text);
    cursor: pointer;
    transition: background-color var(--transition-default);
  }

  .file-label:hover {
    background-color: var(--color-surface-strong);
  }

  .file-name:not([data-has-file]) {
    color: var(--color-text-subtle);
  }

  .file-input:focus-visible + .file-label {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .file-input[aria-invalid="true"] + .file-label {
    border-color: var(--color-error);
  }
</style>
