---
interface Props {
  id: string;
  name: string;
  label: string;
  type: string;
  required?: boolean;
  width?: string;
  errorId: string;
}

const { id, name, label, type, required = false, width = "full", errorId }: Props = Astro.props;

// Groups of choices are named by a legend; consent carries its statement instead of a label.
const isGroup = type === "checkboxGroup" || type === "radioGroup";
const isConsent = type === "consent";
const Tag = isGroup ? "fieldset" : "div";
---

<Tag
  class="g-form-field"
  data-width={width}
  data-type={type}
  aria-describedby={isGroup ? errorId : undefined}
>
  {isGroup && (
    <legend class="label">
      {label}
      {required && (
        <span class="required" aria-hidden="true">
          *
        </span>
      )}
    </legend>
  )}
  {!isGroup && !isConsent && (
    <label class="label" for={id}>
      {label}
      {required && (
        <span class="required" aria-hidden="true">
          *
        </span>
      )}
    </label>
  )}
  <slot />
  <p
    class="error g-form-error g-text-small"
    id={errorId}
    data-error-for={name}
    aria-live="polite"
  ></p>
</Tag>

<style>
  .label {
    font-weight: var(--font-weight-bold);
  }

  /* Visual only (the control carries `required`); a margin as Astro trims leading spaces. */
  .required {
    margin-left: 0.125em;
  }

  .error:empty {
    display: none;
  }
</style>
