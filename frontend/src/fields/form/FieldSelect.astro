---
interface Props {
  id: string;
  name: string;
  placeholder: string;
  required: boolean;
  options: string[];
  errorId: string;
}

const { id, name, placeholder, required, options, errorId }: Props = Astro.props;
---

<div class="g-select">
  <select id={id} name={name} required={required} aria-describedby={errorId}>
    <option value="">{placeholder}</option>
    {options.map((option) => (
      <option value={option}>{option}</option>
    ))}
  </select>
</div>
