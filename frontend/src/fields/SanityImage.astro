---
import type { SanityImageFragment } from "sanity/generated/graphql";
import { getSanityImageFocalPoint, getSanityImageProps } from "@lib/sanity/images";

interface Props {
  image: SanityImageFragment | null | undefined;
  layout?: "width" | "height" | "cover" | "contain";
  sizes?: [number, number, number];
  loading?: "lazy" | "eager";
  /* Above-the-fold images: skips lazy loading and raises fetch priority for LCP. */
  priority?: boolean;
}

const {
  image,
  layout = "width",
  sizes = [100, 100, 100],
  loading = "lazy",
  priority = false,
}: Props = Astro.props;

const altText = image?.asset?.altText ?? "";
const placeholderSrc = image?.asset?.metadata?.lqip;
const sanityImageProps = getSanityImageProps({ sanityImage: image, sizes });
const aspectRatio =
  sanityImageProps?.width && sanityImageProps?.height
    ? sanityImageProps.width / sanityImageProps.height
    : undefined;
const focalPoint = getSanityImageFocalPoint(image);
---

<div
  class:list={["sanity-image", `layout-${layout}`]}
  style={
    aspectRatio && (layout === "width" || layout === "height")
      ? `aspect-ratio: ${aspectRatio}`
      : undefined
  }
>
  {placeholderSrc && (
    <img
      class:list={["placeholder", `layout-${layout}`]}
      src={placeholderSrc}
      alt=""
      loading="eager"
      aria-hidden="true"
    />
  )}

  {sanityImageProps && (
    <img
      class:list={["image", `layout-${layout}`]}
      {...sanityImageProps}
      style={focalPoint ? `object-position: ${focalPoint}` : undefined}
      alt={altText}
      loading={priority ? "eager" : loading}
      fetchpriority={priority ? "high" : undefined}
      decoding="async"
      onload="this.dataset.loaded = ''"
    />
  )}
</div>

<style>
  .sanity-image {
    position: relative;
    display: grid;
    overflow: hidden;
  }

  .sanity-image > * {
    min-width: 0;
    min-height: 0;
    grid-area: 1 / 1;
  }

  .placeholder {
    pointer-events: none;
    opacity: 1;
    filter: blur(100px);
    transition: opacity var(--transition-media);
  }

  .sanity-image:has(.image[data-loaded]) .placeholder {
    opacity: 0;
  }

  .layout-width .placeholder,
  .layout-height .placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image {
    opacity: 0;
    transition: opacity var(--transition-media);
  }

  .image[data-loaded] {
    opacity: var(--media-opacity, 1);
  }

  .layout-width {
    width: 100%;
  }

  .layout-height {
    height: 100%;
  }

  .image.layout-width {
    height: auto;
  }
  .image.layout-height {
    width: auto;
  }

  .layout-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .layout-contain {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
