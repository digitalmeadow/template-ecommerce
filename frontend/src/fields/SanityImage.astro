---
import type { SanityImageFragment } from "sanity/generated/graphql";
import { getSanityImageProps } from "@lib/sanity/images";

interface Props {
  imageData: SanityImageFragment | null | undefined;
  layout?: "width" | "height" | "cover" | "contain";
  sizes?: [number, number, number];
  loading?: "lazy" | "eager";
  mediaId?: string | null;
}

const {
  imageData,
  layout = "width",
  sizes = [100, 100, 100],
  loading = "lazy",
  mediaId,
}: Props = Astro.props;

const altText = imageData?.asset?.altText ?? "";
const blurhashSrc = imageData?.asset?.metadata?.lqip;
const aspectRatio = imageData?.asset?.metadata?.dimensions?.aspectRatio;
const sanityImageProps = imageData ? getSanityImageProps({ sanityImage: imageData, sizes }) : [];
---

<div
  class:list={["sanity-image", `layout-${layout}`]}
  style={aspectRatio && (layout === "width" || layout === "height")
    ? `aspect-ratio: ${aspectRatio}`
    : undefined}
>
  <img
    class:list={["blurhash", `layout-${layout}`]}
    src={blurhashSrc}
    alt=""
    loading="eager"
    aria-hidden="true"
  />

  <img
    class:list={["image", `layout-${layout}`]}
    data-media-id={mediaId}
    {...sanityImageProps}
    alt={altText}
    loading={loading}
    onload="this.dataset.loaded = ''"
  />
</div>

<style>
  .sanity-image {
    position: relative;
    display: grid;
    overflow: hidden;
  }

  .sanity-image > * {
    grid-area: 1 / 1;
    min-width: 0;
    min-height: 0;
  }

  .blurhash {
    opacity: 1;
    transition: opacity var(--transition-media-load);
    pointer-events: none;
    filter: blur(100px);
  }

  .sanity-image:has(.image[data-loaded]) .blurhash {
    opacity: 0;
  }

  .layout-width .blurhash,
  .layout-height .blurhash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image {
    opacity: 0;
    transition: opacity var(--transition-media-load);
  }

  .image[data-loaded]:not([data-loaded="false"]) {
    opacity: var(--media-opacity, 1);
  }

  .layout-width {
    width: 100%;
  }

  .layout-height {
    height: 100%;
  }

  .layout-cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .layout-contain {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
