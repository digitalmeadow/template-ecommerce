---
import type { LinkFragment } from "sanity/generated/graphql";
import { resolveSanityLink } from "@lib/sanity/links";
import { anchorAttributes } from "@lib/sanity/resolve";

interface Props {
  linkData: LinkFragment | null | undefined;
  class?: string;
  [attribute: string]: unknown;
}

const { linkData, class: className, ...rest }: Props = Astro.props;

const link = await resolveSanityLink(linkData);
---

{link ? (
  <a class={className} href={link.href} {...anchorAttributes(link)} {...rest}>
    <slot />
  </a>
) : (
  <slot />
)}
