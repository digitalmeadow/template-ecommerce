---
import type { LinkFragment } from "sanity/generated/graphql";
import { resolveSanityLink } from "@lib/sanity/links";
import { anchorAttributes } from "@lib/sanity/resolve";
import { getRenderLocale, localizeHref } from "@lib/shopify/locale";

interface Props {
  link: LinkFragment | null | undefined;
  class?: string;
  [attribute: string]: unknown;
}

const { link, class: className, ...rest }: Props = Astro.props;

const resolvedLink = await resolveSanityLink(link);
const href = resolvedLink && localizeHref(resolvedLink.href, getRenderLocale(Astro));
---

{resolvedLink ? (
  <a class={className} href={href} {...anchorAttributes(resolvedLink)} {...rest}>
    <slot />
  </a>
) : (
  <slot />
)}
