---
import type { MuxVideoFragment } from "sanity/generated/graphql";
import { fetchMuxBlurUp } from "@lib/video";

interface Props {
  video: MuxVideoFragment | null | undefined;
  layout?: "width" | "height" | "cover" | "contain";
  loading?: "lazy" | "eager";
}

const { video, layout = "width", loading = "lazy" }: Props = Astro.props;

const aspectRatio = video?.asset?.data?.aspect_ratio?.replace(":", "/");
const playbackId = video?.asset?.playbackId;
const posterUrl = playbackId
  ? `https://image.mux.com/${playbackId}/thumbnail.jpg?fit_mode=crop&time=0`
  : undefined;
const placeholderSrc = playbackId ? (await fetchMuxBlurUp(playbackId)).imageDataURL : undefined;
---

<script>
  import "@mux/mux-player";
</script>

<div
  class:list={["mux-video", `layout-${layout}`]}
  style={aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined}
>
  {placeholderSrc && <img class="placeholder" src={placeholderSrc} alt="" aria-hidden="true" />}

  <mux-player
    class="video"
    playback-id={playbackId}
    layout={layout}
    loading={loading}
    poster={posterUrl}
    autoplay="muted"
    loop
    title={video?.asset?.filename}
    min_resolution="720p"
    oncanplay="this.dataset.loaded = ''"
  ></mux-player>
</div>

<style>
  mux-player {
    --controls: none;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--transition-media);
  }

  mux-player[data-loaded] {
    opacity: var(--media-opacity, 1);
  }

  .mux-video {
    position: relative;
  }

  .placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .layout-width {
    width: 100%;
  }

  .layout-height {
    height: 100%;
  }

  .layout-cover {
    position: absolute;
    top: 50%;
    left: 50%;
    width: auto;
    min-width: 100%;
    min-height: 100%;
    object-fit: cover;
    transform: translateX(-50%) translateY(-50%);
  }

  .layout-contain {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
