---
import type {
  Props as PortableTextProps,
  Mark as PortableTextMark,
} from "astro-portabletext/types";
import { Mark as DefaultMark } from "astro-portabletext/components";
import SanityLink from "@fields/SanityLink.astro";

type Props = PortableTextProps<PortableTextMark>;

const props: Props = Astro.props;
const { node } = props;
---

{node.markType === "link" && node.markDef ? (
  <SanityLink class="text-link" linkData={node.markDef}>
    <slot />
  </SanityLink>
) : (
  <DefaultMark {...props}>
    <slot />
  </DefaultMark>
)}
