---
import { PortableText as AstroPortableText } from "astro-portabletext";
import Mark from "@fields/portableTextComponents/Mark.astro";

interface Props {
  value: unknown;
  class?: string | undefined;
}

const { value, class: className }: Props = Astro.props;

const components = {
  mark: Mark,
};
---

<div class:list={["portable-text", className]}>
  {/* Codegen types Portable Text as `unknown`; Sanity's schema guarantees the shape. */}
  <AstroPortableText
    value={value as Parameters<typeof AstroPortableText>[0]["value"]}
    components={components}
  />
</div>

<style>
  .portable-text :global(p),
  .portable-text :global(li) {
    margin-bottom: 0.5em;
  }
  .portable-text :global(p:last-child),
  .portable-text :global(li:last-child) {
    margin-bottom: 0;
  }

  .portable-text :global(li) {
    padding-left: 2em;
  }

  .portable-text :global(ul) {
    margin-bottom: 1em;
  }
</style>
