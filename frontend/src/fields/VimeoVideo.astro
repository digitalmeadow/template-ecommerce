---
import type { VimeoVideoFragment } from "sanity/generated/graphql";
import { fetchVimeoOEmbed } from "@lib/video";

interface Props {
  video: VimeoVideoFragment | null | undefined;
  layout?: "width" | "height" | "cover" | "contain";
  loading?: "lazy" | "eager";
}

const { video, layout = "width", loading = "lazy" }: Props = Astro.props;

const videoId = video?.url?.split("/").pop();

const embedParams = new URLSearchParams({
  title: "0",
  byline: "0",
  portrait: "0",
  controls: "0",
  autoplay: "1",
  muted: "1",
  loop: "1",
  autopause: "0",
});

const embedUrl = `https://player.vimeo.com/video/${videoId}?${embedParams.toString()}`;

const oEmbed = video?.url ? await fetchVimeoOEmbed(video.url) : null;
const thumbnailUrl = oEmbed?.thumbnail_url;
const videoWidth = oEmbed?.width;
const videoHeight = oEmbed?.height;

// The player letterboxes inside its iframe, so cropping needs the source ratio.
const videoRatio = videoWidth && videoHeight ? videoWidth / videoHeight : undefined;
---

<div
  class:list={["vimeo-video", `layout-${layout}`]}
  data-vimeo-video
  style={videoRatio ? `--video-ratio: ${videoRatio};` : undefined}
>
  {thumbnailUrl && (
    <img class="placeholder" src={thumbnailUrl} alt="" loading="eager" aria-hidden="true" />
  )}
  <iframe
    class="video"
    src={embedUrl}
    title={oEmbed?.title || "Video"}
    loading={loading}
    allow="autoplay; fullscreen; picture-in-picture"
    allowfullscreen
  ></iframe>
</div>

<script>
  import Player from "@vimeo/player";

  let cleanups: (() => void)[] = [];

  document.addEventListener("astro:page-load", () => {
    cleanups = [];

    document.querySelectorAll<HTMLElement>("[data-vimeo-video]").forEach((root) => {
      const iframe = root.querySelector<HTMLIFrameElement>("iframe");
      if (!iframe) return;

      const reveal = () => {
        iframe.dataset.loaded = "";
      };

      const player = new Player(iframe);
      player.on("play", reveal);
      player
        .getPaused()
        .then((paused) => {
          if (!paused) reveal();
        })
        .catch(() => {});
      cleanups.push(() => {
        player.destroy().catch(() => {});
      });
    });
  });

  document.addEventListener("astro:before-swap", () => {
    cleanups.forEach((cleanup) => cleanup());
    cleanups = [];
  });
</script>

<style>
  .vimeo-video {
    --ratio: var(--video-ratio, 1.7778);

    position: relative;
    display: grid;
    overflow: hidden;
  }

  .vimeo-video > * {
    min-width: 0;
    min-height: 0;
    grid-area: 1 / 1;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    pointer-events: none;
    object-fit: cover;
    opacity: 1;
    filter: blur(100px);
    transition: opacity var(--transition-media);
  }

  .vimeo-video:has(.video[data-loaded]) .placeholder {
    opacity: 0;
  }

  .video {
    width: 100%;
    height: 100%;
    pointer-events: none; /* decorative player — clicks and hover belong to the parent */
    border: 0;
    opacity: 0;
    transition: opacity var(--transition-media);
  }

  .video[data-loaded] {
    opacity: var(--media-opacity, 1);
  }

  .layout-width {
    width: 100%;
    aspect-ratio: var(--ratio);
  }

  .layout-height {
    height: 100%;
    aspect-ratio: var(--ratio);
  }

  .layout-cover,
  .layout-contain {
    width: 100%;
    height: 100%;
    container-type: size;
  }

  /* Emulates object-fit on the iframe; absolute + translate because overflowing grid items anchor start. */
  .layout-cover .video,
  .layout-contain .video {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
  }

  .layout-cover .video {
    width: max(100cqw, calc(100cqh * var(--ratio)));
    height: max(100cqh, calc(100cqw / var(--ratio)));
  }

  .layout-contain .video {
    width: min(100cqw, calc(100cqh * var(--ratio)));
    height: min(100cqh, calc(100cqw / var(--ratio)));
  }
</style>
