---
import type { VimeoVideoFragment } from "sanity/generated/graphql";

interface Props {
  videoData: VimeoVideoFragment | null | undefined;
  layout?: "width" | "height" | "cover" | "contain";
  loading?: "lazy" | "eager";
  mediaId?: string | null;
}

const { videoData, layout = "width", loading = "lazy", mediaId }: Props = Astro.props;

const videoId = videoData?.url?.split("/").pop();

const embedParams = new URLSearchParams({
  title: "0",
  byline: "0",
  portrait: "0",
  controls: "0",
  autoplay: "1",
  muted: "1",
  loop: "1",
  autopause: "0",
});

const embedUrl = `https://player.vimeo.com/video/${videoId}?${embedParams.toString()}`;

let thumbnailUrl: string | undefined;
let videoTitle: string | undefined;
let videoWidth: number | undefined;
let videoHeight: number | undefined;
if (videoData?.url) {
  try {
    const res = await fetch(
      `https://vimeo.com/api/oembed.json?url=${encodeURIComponent(videoData.url)}`,
    );
    if (res.ok) {
      ({
        thumbnail_url: thumbnailUrl,
        title: videoTitle,
        width: videoWidth,
        height: videoHeight,
      } = (await res.json()) as {
        thumbnail_url?: string;
        title?: string;
        width?: number;
        height?: number;
      });
    }
  } catch {
    console.error("Failed to fetch Vimeo thumbnail for", videoData.url);
  }
}

// The player letterboxes inside its iframe, so cropping needs the source ratio.
const videoRatio = videoWidth && videoHeight ? videoWidth / videoHeight : undefined;
---

<div
  class:list={["vimeo-video", `layout-${layout}`]}
  data-vimeo-video
  style={videoRatio ? `--video-ratio: ${videoRatio};` : undefined}
>
  {
    thumbnailUrl && (
      <img class="blurhash" src={thumbnailUrl} alt="" loading="eager" aria-hidden="true" />
    )
  }
  <iframe
    class="video"
    data-media-id={mediaId}
    src={embedUrl}
    title={videoTitle || "Video"}
    loading={loading}
    allow="autoplay; fullscreen; picture-in-picture"
    allowfullscreen></iframe>
</div>

<script>
  import Player from "@vimeo/player";

  let cleanups: (() => void)[] = [];

  document.addEventListener("astro:page-load", () => {
    cleanups = [];

    document.querySelectorAll<HTMLElement>("[data-vimeo-video]").forEach((root) => {
      const iframe = root.querySelector<HTMLIFrameElement>("iframe");
      if (!iframe) return;

      const reveal = () => {
        iframe.dataset.loaded = "";
      };

      const player = new Player(iframe);
      player.on("play", reveal);
      player
        .getPaused()
        .then((paused) => {
          if (!paused) reveal();
        })
        .catch(() => {});
      cleanups.push(() => {
        player.destroy().catch(() => {});
      });
    });
  });

  document.addEventListener("astro:before-swap", () => {
    cleanups.forEach((cleanup) => cleanup());
    cleanups = [];
  });
</script>

<style>
  .vimeo-video {
    --ratio: var(--video-ratio, 1.7778);

    position: relative;
    display: grid;
    overflow: hidden;
  }

  .vimeo-video > * {
    grid-area: 1 / 1;
    min-width: 0;
    min-height: 0;
  }

  .blurhash {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity var(--transition-media-load);
    pointer-events: none;
    filter: blur(100px);
  }

  .vimeo-video:has(.video[data-loaded]) .blurhash {
    opacity: 0;
  }

  .video {
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none; /* decorative player — clicks and hover belong to the parent */
    opacity: 0;
    transition: opacity var(--transition-media-load);
  }

  .video[data-loaded] {
    opacity: var(--media-opacity, 1);
  }

  .layout-width {
    width: 100%;
    aspect-ratio: var(--ratio);
  }

  .layout-height {
    height: 100%;
    aspect-ratio: var(--ratio);
  }

  .layout-cover,
  .layout-contain {
    width: 100%;
    height: 100%;
    container-type: size;
  }

  /* Emulates object-fit on the iframe; absolute + translate because overflowing grid items anchor start. */
  .layout-cover .video,
  .layout-contain .video {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
  }

  .layout-cover .video {
    width: max(100cqw, calc(100cqh * var(--ratio)));
    height: max(100cqh, calc(100cqw / var(--ratio)));
  }

  .layout-contain .video {
    width: min(100cqw, calc(100cqh * var(--ratio)));
    height: min(100cqh, calc(100cqw / var(--ratio)));
  }
</style>
