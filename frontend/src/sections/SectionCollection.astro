---
import type { SectionCollectionFragment } from "sanity/generated/graphql";
import { fetchShopifyCollectionWithThumbnails } from "@lib/fetches/collectionShopifySanity";
import ProductThumbnailsGrid from "./product/ProductThumbnailsGrid.astro";

interface Props {
  section: SectionCollectionFragment;
}

const { section }: Props = Astro.props;

const handle = section.collection?.shopify?.handle?.current;
const collection = handle ? await fetchShopifyCollectionWithThumbnails(handle) : null;
---

{collection && (
  <section
    data-color-scheme={section.colorScheme ?? undefined}
    class="section-collection u-container"
    id={section.id ?? undefined}
  >
    <h2>
      Collection: {section.collection?.shopify?.title}
      <sup>({collection.shopify?.products.edges.length ?? 0})</sup>
    </h2>

    <ProductThumbnailsGrid productsData={collection.productThumbnails} />
  </section>
)}

<style>
  .section-collection {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
</style>
