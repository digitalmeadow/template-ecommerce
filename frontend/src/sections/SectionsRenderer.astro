---
import type {
  SectionAccordionsFragment,
  SectionCollectionFragment,
  SectionFormFragment,
  SectionHeroFragment,
  SectionTabsFragment,
  SectionTextFragment,
} from "sanity/generated/graphql";
import SectionHero from "@sections/SectionHero.astro";
import SectionText from "@sections/SectionText.astro";
import SectionCollection from "@sections/SectionCollection.astro";
import SectionAccordions from "@sections/SectionAccordions.astro";
import SectionTabs from "@sections/SectionTabs.astro";
import SectionForm from "@sections/SectionForm.astro";

type Section =
  | SectionAccordionsFragment
  | SectionCollectionFragment
  | SectionFormFragment
  | SectionHeroFragment
  | SectionTabsFragment
  | SectionTextFragment;

interface Props {
  sections: (Section | null)[] | null | undefined;
}

const { sections }: Props = Astro.props;
---

{
  sections?.map((section) => {
    if (!section) return null;

    if (section.__typename === "SectionHero") {
      return <SectionHero section={section} />;
    }

    if (section.__typename === "SectionText") {
      return <SectionText section={section} />;
    }

    if (section.__typename === "SectionCollection") {
      return <SectionCollection section={section} />;
    }

    if (section.__typename === "SectionAccordions") {
      return <SectionAccordions section={section} />;
    }

    if (section.__typename === "SectionTabs") {
      return <SectionTabs section={section} />;
    }

    if (section.__typename === "SectionForm") {
      return <SectionForm section={section} />;
    }

    return null;
  })
}
