---
import type { SectionTabsFragment } from "sanity/generated/graphql";
import PortableText from "@fields/PortableText.astro";
import SanityMedia from "@fields/SanityMedia.astro";
import Tabs from "@layouts/Tabs.astro";

interface Props {
  section: SectionTabsFragment;
}

const { section }: Props = Astro.props;

const tabItems = section.tabItems ?? [];
---

<section
  data-color-scheme={section.colorScheme ?? undefined}
  class="section-tabs g-page-margin g-section-lg"
  id={section.id ?? undefined}
>
  <Tabs id={section._key ?? undefined}>
    {tabItems.map(
      (item, index) =>
        item && (
          <button
            slot="triggers"
            type="button"
            role="tab"
            data-tab-trigger
            id={`tab-${section._key}-trigger-${index}`}
            aria-controls={`tab-${section._key}-panel-${index}`}
          >
            {item.title}
          </button>
        ),
    )}
    {tabItems.map(
      (item, index) =>
        item && (
          <div
            slot="panels"
            role="tabpanel"
            data-tab-panel
            id={`tab-${section._key}-panel-${index}`}
            aria-labelledby={`tab-${section._key}-trigger-${index}`}
            class="panel"
          >
            <PortableText value={item.contentRaw} />
            {item.media && <SanityMedia media={item.media} sizes={[50, 100, 100]} />}
          </div>
        ),
    )}
  </Tabs>
</section>

<style>
  .panel {
    display: flex;
    flex-direction: column;
    row-gap: var(--size-8);
  }

  /* Tabs renders these parts; this section lays them out. */
  .section-tabs :global(tabs-root) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gutter);
    align-items: start;
  }

  .section-tabs :global([data-tabs-triggers]) {
    display: flex;
    flex-direction: column;
    border-bottom: var(--border-width-1) solid var(--color-rule);
  }

  .section-tabs :global([data-tabs-panels]) {
    padding-left: calc(var(--column) + var(--gutter));
  }

  .section-tabs :global([data-tab-trigger]) {
    padding-block: var(--size-4);
    color: var(--color-text-subtle);
    text-align: left;
    border-top: var(--border-width-1) solid var(--color-rule);
    transition: color var(--transition-default);
  }

  .section-tabs :global([data-tab-trigger]:hover),
  .section-tabs :global([data-tab-trigger][data-state="active"]) {
    color: var(--color-text);
  }

  @media (max-width: 48rem) {
    .section-tabs :global(tabs-root) {
      grid-template-columns: minmax(0, 1fr);
    }

    .section-tabs :global([data-tabs-panels]) {
      margin-top: var(--size-10);
      padding-left: 0;
    }
  }
</style>
