---
import PortableText from "@fields/PortableText.astro";
import Accordion from "@layouts/Accordion.astro";
import type { ProductShopifySanity } from "@lib/fetches/productShopifySanity";
import ProductGallery from "@sections/product/ProductGallery.astro";
import ProductPurchase from "@sections/product/ProductPurchase.astro";
import ProductLive from "@sections/product/ProductLive.astro";
import ProductAnalytics from "@sections/product/ProductAnalytics.astro";

interface Props {
  productData: ProductShopifySanity;
}

const { productData }: Props = Astro.props;
---

<section
  class="product-main g-page-margin"
  data-product-root
  data-product-handle={productData.shopify.handle}
  data-product-analytics={JSON.stringify({
    id: productData.shopify.id,
    title: productData.shopify.title,
    vendor: productData.shopify.vendor,
    productType: productData.shopify.productType,
  })}
>
  <ProductLive />
  <ProductAnalytics />
  <ProductGallery productData={productData} />
  <div class="product-purchase">
    <ProductPurchase productData={productData} />

    <div class="accordions">
      {productData.sanity.accordions?.map((accordion) => {
        if (!accordion) return null;
        return (
          <Accordion group="product" summary={accordion.summary}>
            <div class="content" slot="content">
              <PortableText value={accordion.contentRaw} />
            </div>
          </Accordion>
        );
      })}
    </div>
  </div>
</section>

<style>
  .product-main {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: var(--gutter);
    padding-top: var(--size-40);
  }

  .product-purchase {
    position: sticky;
    top: var(--size-40);
    height: calc(100svh - var(--size-40));
    display: flex;
    flex-direction: column;
    row-gap: var(--size-10);
    padding-left: calc(var(--column) + var(--gutter));
  }

  .accordions {
    margin-top: auto;
    padding-bottom: var(--margin);
  }

  @media (max-width: 48rem) {
    .product-main {
      display: flex;
      flex-direction: column-reverse;
    }

    .product-purchase {
      position: static;
      height: auto;
      padding-left: 0;
    }
  }
</style>
