---
import QuantitySelector from "@blocks/QuantitySelector.astro";
import FontSizeFillWidth from "@layouts/FontSizeFillWidth.astro";
import type { ProductShopifySanity } from "@lib/fetches/productShopifySanity";
import { getRenderLocale } from "@lib/shopify/locale";
import { getInitialVariant } from "@lib/shopify/variants";
import ProductAddToCart from "@sections/product/ProductAddToCart.astro";
import ProductPrice from "@sections/product/ProductPrice.astro";
import ProductVariantSelector from "@sections/product/ProductVariantSelector.astro";

interface Props {
  product: ProductShopifySanity;
}

const { product }: Props = Astro.props;
const { shopify } = product;
const initialVariant = getInitialVariant(shopify.variants.nodes);
---

<div class="product-purchase">
  <FontSizeFillWidth>
    <h1>{shopify.title}</h1>
  </FontSizeFillWidth>
  <ProductPrice
    priceRange={shopify.priceRange}
    compareAtPriceRange={shopify.compareAtPriceRange}
    variant={initialVariant}
  />

  <form class="purchase-form" method="post" action="/api/cart">
    <input type="hidden" name="locale" value={getRenderLocale(Astro).path} />

    <div class="variant-selector">
      <ProductVariantSelector product={product} />
    </div>

    <div class="purchase">
      <ProductAddToCart isAvailable={Boolean(initialVariant?.availableForSale)} />
      <QuantitySelector name="quantity" />
    </div>
  </form>
</div>

<style>
  .product-purchase {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  h1 {
    margin-bottom: var(--size-5);
    text-transform: uppercase;
  }

  .purchase-form {
    display: contents;
  }

  .variant-selector,
  .purchase {
    margin-top: var(--size-10);
  }

  .purchase {
    display: flex;
    gap: var(--size-6);
    align-items: center;
  }
</style>
