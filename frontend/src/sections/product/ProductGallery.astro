---
import SanityMedia from "@fields/SanityMedia.astro";
import type { ProductShopifySanity } from "@lib/fetches/productShopifySanity";

interface Props {
  product: ProductShopifySanity;
}

const { product }: Props = Astro.props;
---

<div class="product-gallery">
  <div class="media-item">
    <SanityMedia media={product.sanity.mediaThumbnail} layout="width" />
  </div>

  {product.sanity.mediaGallery?.map((mediaItem) => (
    <div class="media-item">
      <SanityMedia media={mediaItem} layout="width" />
    </div>
  ))}
</div>

<style>
  .product-gallery {
    width: 100%;
    display: grid;
    gap: var(--gutter);
  }

  .media-item {
    width: 100%;
  }
</style>
