---
interface Props {
  /* The opening variant's availability, so "Sold Out" is in the static HTML. */
  isAvailable: boolean;
}

const { isAvailable }: Props = Astro.props;
---

<div class="product-add-to-cart" data-product-add-to-cart>
  <button
    type="submit"
    name="intent"
    value="add"
    class="g-text-link"
    data-add-to-cart-button
    data-available-for-sale={String(isAvailable)}
    disabled={!isAvailable}
  ></button>
</div>

<script>
  import type { EventProductVariantChange } from "@lib/events";
  import { addToCart } from "@stores/cart";
  import { setCartOpen } from "@stores/ui";

  function initialiseProductAddToCart(rootElement: HTMLElement): () => void {
    const productRoot = rootElement.closest("[data-product-root]") as HTMLElement;
    if (!productRoot) throw new Error("ProductAddToCart: missing [data-product-root]");

    const button = rootElement.querySelector("[data-add-to-cart-button]") as HTMLButtonElement;
    const form = rootElement.closest("form") as HTMLFormElement;
    if (!form) throw new Error("ProductAddToCart: missing parent <form>");
    const quantitySelector = form.querySelector("quantity-selector");

    let isAvailable = button.dataset.availableForSale === "true";

    async function handleSubmit(event: SubmitEvent) {
      event.preventDefault();
      const formData = new FormData(form);
      const variantId = String(formData.get("merchandiseId") ?? "");
      const quantity = Number(formData.get("quantity") ?? 1);
      if (!variantId || !Number.isFinite(quantity) || quantity < 1) return;

      button.disabled = true;
      button.dataset.loading = "";
      try {
        await addToCart(variantId, quantity);
        setCartOpen(true);
      } finally {
        delete button.dataset.loading;
        button.disabled = !isAvailable;
      }
    }

    function handleVariantChange(event: Event) {
      const { availableForSale, quantityAvailable } = (event as EventProductVariantChange).detail
        .variant;
      isAvailable = availableForSale;
      button.dataset.availableForSale = String(availableForSale);
      button.disabled = !availableForSale;
      // Null when inventory isn't tracked or the token can't read it.
      if (quantityAvailable != null && quantityAvailable > 0) {
        quantitySelector?.setAttribute("max", String(quantityAvailable));
      } else {
        quantitySelector?.removeAttribute("max");
      }
    }

    productRoot.addEventListener("product:variant-change", handleVariantChange);
    form.addEventListener("submit", handleSubmit);
    productRoot.dispatchEvent(new CustomEvent("product:request-variant-update", { bubbles: true }));

    return () => {
      productRoot.removeEventListener("product:variant-change", handleVariantChange);
      form.removeEventListener("submit", handleSubmit);
    };
  }

  let cleanups: (() => void)[] = [];

  document.addEventListener("astro:page-load", () => {
    cleanups = [];
    document.querySelectorAll<HTMLElement>("[data-product-add-to-cart]").forEach((rootElement) => {
      cleanups.push(initialiseProductAddToCart(rootElement));
    });
  });

  document.addEventListener("astro:before-swap", () => {
    cleanups.forEach((cleanup) => cleanup());
    cleanups = [];
  });
</script>

<style>
  [data-product-add-to-cart] [data-add-to-cart-button]::before {
    content: "Add to Cart";
  }

  [data-product-add-to-cart] [data-add-to-cart-button][data-available-for-sale="false"]::before {
    content: "Sold Out";
  }

  [data-product-add-to-cart] [data-add-to-cart-button][data-loading]::before {
    content: "Adding to cart";
  }
</style>
