---
import type { ProductThumbnailShopifySanity } from "@lib/fetches/productShopifySanity";
import Carousel from "@layouts/Carousel.astro";
import ProductThumbnail from "@sections/product/ProductThumbnail.astro";

interface Props {
  productsData: ProductThumbnailShopifySanity[] | null | undefined;
}

const { productsData }: Props = Astro.props;
---

{
  productsData && productsData.length > 0 && (
    <section class="u-container">
      <div class="top">
        <h2>Related Products</h2>

        <div class="carousel-controls">
          <button
            data-carousel-trigger-prev="related-products-carousel"
            aria-label="Previous related products"
          >
            ←
          </button>
          <button
            data-carousel-trigger-next="related-products-carousel"
            aria-label="Next related products"
          >
            →
          </button>
        </div>
      </div>

      <Carousel id="related-products-carousel">
        <Fragment slot="content">
          {productsData.map((productData) => (
            <div class="carousel-item">
              <ProductThumbnail productData={productData} />
            </div>
          ))}
        </Fragment>
      </Carousel>
    </section>
  )
}

<style>
  section {
    margin-top: var(--s80);
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--s16);
    column-gap: var(--s4);
  }

  .carousel-controls {
    display: flex;
    gap: var(--s4);
  }

  .carousel-item {
    width: calc(4 * var(--column) + 3 * var(--gutter));
    margin-right: var(--gutter);
  }
  @media (max-width: 64rem) {
    .carousel-item {
      width: calc(8 * var(--column) + 7 * var(--gutter));
    }
  }
</style>

<script>
  import type { CarouselElement } from "@layouts/Carousel.astro.0.mjs";

  // Delegated so buttons rendered on later client-router pages work without rebinding.
  document.addEventListener("click", (event) => {
    const trigger = (event.target as Element | null)?.closest<HTMLElement>(
      "[data-carousel-trigger-prev], [data-carousel-trigger-next]",
    );
    if (!trigger) return;

    const prevId = trigger.dataset.carouselTriggerPrev;
    const carousel = document.querySelector(
      `carousel-root[id="${prevId ?? trigger.dataset.carouselTriggerNext}"]`,
    ) as CarouselElement | null;

    if (prevId) carousel?.api?.scrollPrev();
    else carousel?.api?.scrollNext();
  });
</script>
