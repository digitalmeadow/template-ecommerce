---
import SanityMedia from "@fields/SanityMedia.astro";
import type { ProductThumbnailShopifySanity } from "@lib/fetches/productShopifySanity";
import { resolveSanityHref } from "@lib/sanity/resolve";
import { localizeHref, getRenderLocale } from "@lib/shopify/locale";
import ProductPrice from "./ProductPrice.astro";

interface Props {
  productData: ProductThumbnailShopifySanity;
}

const { productData }: Props = Astro.props;

const handle = productData.sanity.shopify?.handle?.current ?? productData.shopify.handle;
---

<a href={localizeHref(resolveSanityHref("product", handle), getRenderLocale(Astro))}>
  <article
    class="product-thumbnail"
    data-product-root
    data-analytics-item={JSON.stringify({
      id: productData.shopify.id,
      title: productData.shopify.title,
      price: productData.shopify.priceRange.minVariantPrice.amount,
      currencyCode: productData.shopify.priceRange.minVariantPrice.currencyCode,
    })}
  >
    <div class="media">
      <SanityMedia mediaData={productData.sanity.mediaThumbnail} layout="cover" />
    </div>
    <h3 class="title g-heading-6">{productData.shopify?.title}</h3>
    <div class="price">
      <ProductPrice
        priceRange={productData.shopify.priceRange}
        compareAtPriceRange={productData.shopify.compareAtPriceRange}
      />
    </div>
  </article>
</a>

<style>
  a {
    display: contents;
  }

  .product-thumbnail {
    width: 100%;
    height: 100%;

    display: grid;
    grid-template-columns: 100%;
    grid-template-rows: 1fr auto auto;

    transition: filter var(--transition-default);
  }

  :global(.hover-group:hover) .product-thumbnail {
    filter: grayscale(100%);
  }

  .product-thumbnail:hover {
    filter: grayscale(0%) !important;
  }

  .media {
    width: 100%;
  }

  .title {
    margin-top: var(--size-1);
  }
</style>
