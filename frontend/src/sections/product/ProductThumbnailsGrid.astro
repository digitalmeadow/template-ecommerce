---
import type { ProductThumbnailShopifySanity } from "@lib/fetches/productShopifySanity";
import ProductThumbnail from "@sections/product/ProductThumbnail.astro";

interface Props {
  products: ProductThumbnailShopifySanity[];
}

const { products }: Props = Astro.props;
---

<div class="grid hover-group">
  {products.map((product) => (
    <div class="grid-item">
      <ProductThumbnail product={product} />
    </div>
  ))}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gutter);
  }

  /* Every sixth card leads, at twice the size. */
  .grid-item:nth-child(6n + 1) {
    grid-row: span 2;
    grid-column: span 2;
  }

  @media (max-width: 48rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .grid-item:nth-child(6n + 1) {
      grid-row: span 1;
      grid-column: span 1;
    }

    .grid-item:nth-child(5n + 1) {
      grid-row: span 2;
      grid-column: span 2;
    }
  }
</style>
