---
import type { MoneyFragment, PriceRangeFragment } from "shopify/generated/graphql";
import PriceDisplay from "@blocks/PriceDisplay.astro";

interface Props {
  priceRange: PriceRangeFragment;
  compareAtPriceRange: PriceRangeFragment;
  /* Product pages: the variant the page opens on, whose price follows the selection. */
  variant?: { price: MoneyFragment; compareAtPrice?: MoneyFragment | null } | undefined;
}

const { priceRange, compareAtPriceRange, variant }: Props = Astro.props;

const price = variant?.price ?? priceRange.minVariantPrice;
const compareAt = variant ? variant.compareAtPrice : compareAtPriceRange.minVariantPrice;
const isRange =
  !variant && Number(priceRange.maxVariantPrice.amount) > Number(priceRange.minVariantPrice.amount);
const isDiscounted = !!compareAt && Number(compareAt.amount) > Number(price.amount);
---

<div class="product-price" data-product-price={variant ? "variant" : "range"}>
  <PriceDisplay
    kind="compare-at"
    data-price-compare-at
    amount={isDiscounted ? compareAt.amount : undefined}
    currency={isDiscounted ? compareAt.currencyCode : undefined}
    // Astro stringifies booleans on custom elements, so `false` would still render `hidden`.
    hidden={!isDiscounted || undefined}
  />
  <PriceDisplay
    data-price
    amount={price.amount}
    currency={price.currencyCode}
    prefix={isRange ? "from" : undefined}
  />
</div>

<script>
  import type { EventProductVariantChange } from "@lib/events";

  function initialiseProductPrice(rootElement: HTMLElement): () => void {
    const productRoot = rootElement.closest("[data-product-root]") as HTMLElement;
    if (!productRoot) throw new Error("ProductPrice: missing [data-product-root]");

    const priceElement = rootElement.querySelector("[data-price]") as HTMLElement;
    const compareAtElement = rootElement.querySelector("[data-price-compare-at]") as HTMLElement;

    function handleVariantChange(event: Event) {
      const { price, compareAtPrice } = (event as EventProductVariantChange).detail.variant;
      priceElement.setAttribute("amount", price.amount);
      priceElement.setAttribute("currency", price.currencyCode);

      const isDiscounted = !!compareAtPrice && Number(compareAtPrice.amount) > Number(price.amount);
      if (compareAtPrice) {
        compareAtElement.setAttribute("amount", compareAtPrice.amount);
        compareAtElement.setAttribute("currency", compareAtPrice.currencyCode);
      }
      compareAtElement.hidden = !isDiscounted;
    }

    productRoot.addEventListener("product:variant-change", handleVariantChange);
    productRoot.dispatchEvent(new CustomEvent("product:request-variant-update", { bubbles: true }));

    return () => productRoot.removeEventListener("product:variant-change", handleVariantChange);
  }

  let cleanups: (() => void)[] = [];

  document.addEventListener("astro:page-load", () => {
    cleanups = [];
    document
      .querySelectorAll<HTMLElement>('[data-product-price="variant"]')
      .forEach((rootElement) => cleanups.push(initialiseProductPrice(rootElement)));
  });

  document.addEventListener("astro:before-swap", () => {
    cleanups.forEach((cleanup) => cleanup());
    cleanups = [];
  });
</script>
