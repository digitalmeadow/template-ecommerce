---
import type { SectionHeroFragment } from "sanity/generated/graphql";
import FontSizeFillWidth from "@layouts/FontSizeFillWidth.astro";

interface Props {
  section: SectionHeroFragment;
}

const { section }: Props = Astro.props;

// Split server-side so FontSizeFillWidth fits the final per-character layout.
const characters = (section.heading ?? "").trim().split("");
---

<section data-color-scheme={section.colorScheme ?? undefined} class="u-container">
  <FontSizeFillWidth>
    <h1 data-text-animate-colors aria-label={section.heading}>
      {
        characters.map((char) => (
          // The reset makes spans inline-flex, which collapses a lone space to zero width.
          <span class="text-inherit" aria-hidden="true">
            {char === " " ? "\u00a0" : char}
          </span>
        ))
      }
    </h1>
  </FontSizeFillWidth>
</section>

<style>
  section {
    margin-top: var(--s200);
    margin-bottom: var(--s40);
  }
  @media (max-width: 64rem) {
    section {
      margin-top: calc(var(--s200) + var(--s24));
    }
  }
  @media (max-width: 32rem) {
    section {
      margin-top: calc(var(--s200) + var(--s24));
    }
  }

  h1 {
    text-transform: uppercase;
  }
</style>

<script>
  const COLORS = [
    "var(--color-green)",
    "var(--color-blue)",
    "var(--color-purple)",
    "var(--color-yellow)",
    "var(--color-orange)",
  ];

  let cleanups: (() => void)[] = [];
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.addEventListener("astro:page-load", () => {
    cleanups = [];
    if (reduceMotion) return;

    document.querySelectorAll<HTMLElement>("[data-text-animate-colors]").forEach((heading) => {
      const charElements = Array.from(heading.children);

      charElements.forEach((char, index) => {
        const animation = char.animate(
          [
            { color: "var(--color-text)" },
            ...COLORS.map((color) => ({ color })),
            { color: "var(--color-text)" },
          ],
          {
            duration: 2000,
            delay: 500 + index * 50,
            iterations: 1,
          },
        );
        cleanups.push(() => animation.cancel());
      });
    });
  });

  document.addEventListener("astro:before-swap", () => {
    cleanups.forEach((cleanup) => cleanup());
  });
</script>
