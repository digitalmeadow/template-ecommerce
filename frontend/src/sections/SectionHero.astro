---
import type { SectionHeroFragment } from "sanity/generated/graphql";
import FontSizeFillWidth from "@layouts/FontSizeFillWidth.astro";

interface Props {
  section: SectionHeroFragment;
}

const { section }: Props = Astro.props;

// Split server-side so FontSizeFillWidth fits the final per-character layout.
const characters = (section.heading ?? "").trim().split("");
---

<section
  data-color-scheme={section.colorScheme ?? undefined}
  class="section-hero g-page-margin"
  id={section.id ?? undefined}
>
  <FontSizeFillWidth>
    <h1 data-text-animate-colors aria-label={section.heading}>
      {characters.map((char) => (
        <span aria-hidden="true">{char}</span>
      ))}
    </h1>
  </FontSizeFillWidth>
</section>

<style>
  .section-hero {
    padding-block: var(--size-40) var(--size-10);
  }

  h1 {
    text-transform: uppercase;
    white-space: pre;
  }

  @media (max-width: 48rem) {
    .section-hero {
      padding-top: calc(var(--size-40) + var(--size-6));
    }
  }
</style>

<script>
  const COLORS = [
    "var(--color-highlight-green)",
    "var(--color-highlight-blue)",
    "var(--color-highlight-purple)",
    "var(--color-highlight-yellow)",
    "var(--color-highlight-orange)",
  ];

  let cleanups: (() => void)[] = [];
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.addEventListener("astro:page-load", () => {
    cleanups = [];
    if (reduceMotion) return;

    document.querySelectorAll<HTMLElement>("[data-text-animate-colors]").forEach((heading) => {
      const charElements = Array.from(heading.children);

      charElements.forEach((char, index) => {
        const animation = char.animate(
          [
            { color: "var(--color-text)" },
            ...COLORS.map((color) => ({ color })),
            { color: "var(--color-text)" },
          ],
          {
            duration: 2000,
            delay: 500 + index * 50,
            iterations: 1,
          },
        );
        cleanups.push(() => animation.cancel());
      });
    });
  });

  document.addEventListener("astro:before-swap", () => {
    cleanups.forEach((cleanup) => cleanup());
  });
</script>
