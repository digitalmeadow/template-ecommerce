---
import type { SectionAccordionsFragment } from "sanity/generated/graphql";
import Accordion from "@layouts/Accordion.astro";
import PortableText from "@fields/PortableText.astro";

interface Props {
  section: SectionAccordionsFragment;
}

const { section }: Props = Astro.props;
---

<section
  data-color-scheme={section.colorScheme ?? undefined}
  class="section-accordions g-page-margin g-section-md"
  id={section.id ?? undefined}
>
  {section.accordions?.map((accordion) => {
    if (!accordion) return null;
    return (
      <div class="accordion">
        <Accordion group="default" summary={accordion.summary}>
          <div class="content" slot="content">
            <PortableText value={accordion.contentRaw} />
          </div>
        </Accordion>
      </div>
    );
  })}
</section>

<style>
  .section-accordions {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .accordion {
    width: 100%;
    max-width: calc(8 * var(--column) + 7 * var(--gutter));
  }
</style>
