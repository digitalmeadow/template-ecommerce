---
import type { EmblaOptionsType } from "embla-carousel";

interface Props {
  id?: string;
  class?: string;
  align?: EmblaOptionsType["align"];
  dragFree?: boolean;
  loop?: boolean;
  skipSnaps?: boolean;
  slidesToScroll?: EmblaOptionsType["slidesToScroll"];
  breakpoints?: EmblaOptionsType["breakpoints"];
  watchResize?: boolean;
  [attribute: string]: unknown;
}

const {
  id,
  class: className,
  align,
  dragFree,
  loop,
  skipSnaps = true,
  slidesToScroll,
  breakpoints,
  watchResize,
  ...rest
}: Props = Astro.props;
---

<carousel-root
  id={id}
  class={className}
  align={align}
  drag-free={dragFree}
  loop={loop}
  skip-snaps={skipSnaps}
  slides-to-scroll={slidesToScroll}
  breakpoints={breakpoints ? JSON.stringify(breakpoints) : undefined}
  watch-resize={watchResize === false ? "false" : undefined}
  {...rest}
>
  <div data-carousel-viewport>
    <div data-carousel-container>
      <slot name="content" />
    </div>
  </div>
</carousel-root>

<style>
  [data-carousel-viewport] {
    overflow: hidden;
  }

  [data-carousel-container] {
    display: flex;
    cursor: grab;
  }
  [data-carousel-container]:active {
    cursor: grabbing;
  }
</style>

<style is:inline>
  [data-carousel-container] > * {
    flex-shrink: 0;
  }
</style>

<script>
  import EmblaCarousel, { type EmblaOptionsType, type EmblaCarouselType } from "embla-carousel";

  class CarouselElement extends HTMLElement {
    public api: EmblaCarouselType | undefined;
    private viewport: HTMLElement | null = null;

    static get observedAttributes() {
      return [
        "align",
        "drag-free",
        "loop",
        "skip-snaps",
        "slides-to-scroll",
        "breakpoints",
        "watch-resize",
      ];
    }

    connectedCallback() {
      this.viewport = this.querySelector<HTMLElement>("[data-carousel-viewport]");
      this.init();
    }

    disconnectedCallback() {
      this.api?.destroy();
      this.api = undefined;
      this.viewport = null;
    }

    attributeChangedCallback() {
      this.init();
    }

    private init() {
      // attributeChangedCallback fires once per attribute on upgrade, all before connect.
      if (!this.viewport) return;

      this.api?.destroy();

      const breakpointsAttr = this.getAttribute("breakpoints");

      const options: EmblaOptionsType = {
        align: (this.getAttribute("align") as EmblaOptionsType["align"]) || "start",
        dragFree: this.getAttribute("drag-free") !== null,
        loop: this.getAttribute("loop") !== null,
        skipSnaps: this.getAttribute("skip-snaps") !== null,
        slidesToScroll:
          this.getAttribute("slides-to-scroll") === "auto"
            ? "auto"
            : Number(this.getAttribute("slides-to-scroll")) || 1,
        watchResize: this.getAttribute("watch-resize") !== "false",
        breakpoints: breakpointsAttr ? JSON.parse(breakpointsAttr) : undefined,
      };

      this.api = EmblaCarousel(this.viewport, options);
    }
  }

  customElements.define("carousel-root", CarouselElement);

  // Delegated so prev/next buttons anywhere on later client-router pages work without rebinding.
  document.addEventListener("click", (event) => {
    const trigger = (event.target as Element | null)?.closest<HTMLElement>(
      "[data-carousel-trigger-prev], [data-carousel-trigger-next]",
    );
    if (!trigger) return;

    const prevId = trigger.dataset.carouselTriggerPrev;
    const carousel = document.querySelector<CarouselElement>(
      `carousel-root[id="${prevId ?? trigger.dataset.carouselTriggerNext}"]`,
    );

    if (prevId) carousel?.api?.scrollPrev();
    else carousel?.api?.scrollNext();
  });
</script>
