---
interface Props {
  summary: string | null | undefined;
  headingLevel?: 2 | 3 | 4;
  /* Opening one accordion closes the others in the same group. */
  group?: string;
  initOpen?: boolean;
}

const { summary, headingLevel = 2, group, initOpen = false }: Props = Astro.props;

const Heading = `h${headingLevel}` as const;
const contentId = `accordion-${crypto.randomUUID()}`;
---

<accordion-root group={group} init-open={initOpen ? "" : undefined}>
  <Heading class="heading">
    <button
      type="button"
      class="summary"
      aria-expanded={initOpen ? "true" : "false"}
      aria-controls={contentId}
      data-accordion-toggle
    >
      <span class="summary-text">{summary}</span>
      <span class="icon" aria-hidden="true">
        <span class="icon-open">+</span>
        <span class="icon-close">-</span>
      </span>
    </button>
  </Heading>

  <div class="content-container" id={contentId} data-accordion-content>
    <div class="content-inner">
      <div class="content">
        <slot name="content" />
      </div>
    </div>
  </div>
</accordion-root>

<script>
  type EventAccordionOpen = CustomEvent<{ target: HTMLElement }>;

  class AccordionElement extends HTMLElement {
    private toggleElement!: HTMLButtonElement;
    private contentElement!: HTMLElement;
    private group: string | null = null;
    private isOpen = false;

    static get observedAttributes() {
      return ["group", "init-open"];
    }

    connectedCallback() {
      this.toggleElement = this.querySelector("[data-accordion-toggle]")!;
      this.contentElement = this.querySelector("[data-accordion-content]")!;
      this.group = this.getAttribute("group");
      this.isOpen = this.hasAttribute("init-open");

      this.toggleElement.addEventListener("click", this.toggle);
      if (this.group) {
        window.addEventListener(`accordion:opened:${this.group}`, this.handleAccordionOpen);
      }

      this.render();
    }

    disconnectedCallback() {
      this.toggleElement.removeEventListener("click", this.toggle);
      if (this.group) {
        window.removeEventListener(`accordion:opened:${this.group}`, this.handleAccordionOpen);
      }
    }

    attributeChangedCallback() {
      this.render();
    }

    open = () => {
      this.isOpen = true;

      if (this.group) {
        window.dispatchEvent(
          new CustomEvent(`accordion:opened:${this.group}`, { detail: { target: this } }),
        );
      }

      this.render();
    };

    close = () => {
      this.isOpen = false;
      this.render();
    };

    toggle = () => {
      if (this.isOpen) {
        this.close();
      } else {
        this.open();
      }
    };

    private handleAccordionOpen = (event: Event) => {
      if ((event as EventAccordionOpen).detail.target !== this) this.close();
    };

    private render() {
      if (!this.contentElement || !this.toggleElement) return;

      this.toggleElement.setAttribute("aria-expanded", String(this.isOpen));
      this.contentElement.inert = !this.isOpen;

      if (this.isOpen) {
        this.dataset.state = "open";
      } else {
        delete this.dataset.state;
      }
    }
  }

  customElements.define("accordion-root", AccordionElement);
</script>

<style>
  accordion-root {
    margin-top: -1px;
    display: block;
    border-top: 1px solid var(--color-shape-stroke);
  }

  accordion-root:last-child {
    border-bottom: 1px solid var(--color-shape-stroke);
  }

  .summary {
    width: 100%;
    padding: var(--s4) 0;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: var(--s8);
    text-align: left;
  }

  [data-accordion-content] {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--transition-default);
  }

  [data-accordion-content] > * {
    overflow: hidden;
  }

  accordion-root[data-state="open"] [data-accordion-content] {
    grid-template-rows: 1fr;
  }

  .icon {
    display: grid;
    align-items: center;
    justify-items: center;
    width: var(--s16);
    height: var(--s16);
    font-size: 1.125rem;
    line-height: 1;
  }

  .icon-open,
  .icon-close {
    grid-area: 1 / 1 / 2 / 2;
    transition: opacity var(--transition-default);
  }

  .icon-close {
    opacity: 0;
  }

  accordion-root[data-state="open"] .icon-open {
    opacity: 0;
  }

  accordion-root[data-state="open"] .icon-close {
    opacity: 1;
  }

  .content {
    padding: var(--s8) 0 var(--s24) 2em;
  }
</style>
