---
interface Props {
  id: string;
  layout?: "fullscreen" | "right";
  "aria-label"?: string;
}

const { id, layout = "fullscreen", "aria-label": ariaLabel }: Props = Astro.props;
---

<overlay-root id={id} layout={layout} data-aria-label={ariaLabel}>
  <div class="backdrop"></div>

  <div class:list={["panel", layout]}>
    <slot name="header" />
    <slot name="content" />
  </div>
</overlay-root>

<script>
  import { trapFocus } from "@lib/focus";

  class OverlayElement extends HTMLElement {
    private backdrop!: HTMLElement;
    private panel!: HTMLElement;
    private previouslyFocused: HTMLElement | null = null;
    private previousScrollY: number = 0;
    isOpen: boolean = false;

    connectedCallback() {
      this.backdrop = this.querySelector(".backdrop")!;
      this.panel = this.querySelector(".panel")!;

      this.panel.setAttribute("role", "dialog");
      this.panel.setAttribute("aria-modal", "true");
      this.panel.setAttribute("tabindex", "-1");

      const label = this.dataset.ariaLabel;
      if (label) {
        this.panel.setAttribute("aria-label", label);
      }

      this.backdrop.addEventListener("click", this.handleCloseClick);
      this.render();
    }

    disconnectedCallback() {
      this.backdrop.removeEventListener("click", this.handleCloseClick);
      if (this.isOpen) this.dismiss();
    }

    lockScroll() {
      this.previousScrollY = window.pageYOffset;
      const scrollingElement = document.scrollingElement as HTMLElement | null;
      if (scrollingElement) {
        scrollingElement.style.overflow = "hidden";
        scrollingElement.style.top = -this.previousScrollY + "px";
        scrollingElement.style.position = "fixed";
        scrollingElement.style.width = "100%";
        scrollingElement.style.paddingRight = "var(--scrollbar)";
      }
    }

    unlockScroll(restoreScroll = true) {
      const scrollingElement = document.scrollingElement as HTMLElement | null;
      if (scrollingElement) {
        scrollingElement.style.overflow = "";
        scrollingElement.style.top = "";
        scrollingElement.style.position = "";
        scrollingElement.style.width = "";
        scrollingElement.style.paddingRight = "";
        if (!restoreScroll) return;
        const previousScrollBehavior = document.documentElement.style.scrollBehavior;
        document.documentElement.style.scrollBehavior = "auto";
        window.scrollTo(0, this.previousScrollY);
        document.documentElement.style.scrollBehavior = previousScrollBehavior;
      }
    }

    open() {
      if (this.isOpen) return;
      this.isOpen = true;
      this.previouslyFocused = document.activeElement as HTMLElement;

      document.addEventListener("keydown", this.handleCloseKeydown);
      document.addEventListener("astro:before-swap", this.dismiss);

      requestAnimationFrame(() => {
        this.panel?.focus();
      });

      this.dispatchEvent(new CustomEvent("overlay:opened"));
      this.render();
      this.lockScroll();
    }

    handleCloseClick = () => {
      this.close();
    };

    handleCloseKeydown = (event: KeyboardEvent) => {
      if (!this.isOpen) return;

      if (event.key === "Escape") {
        event.preventDefault();
        this.close();
        return;
      }

      trapFocus(this.panel, event);
    };

    close() {
      if (!this.isOpen) return;
      this.isOpen = false;

      document.removeEventListener("keydown", this.handleCloseKeydown);
      document.removeEventListener("astro:before-swap", this.dismiss);

      if (this.previouslyFocused) {
        this.previouslyFocused.focus();
      }

      this.dispatchEvent(new CustomEvent("overlay:closed"));
      this.render();
      this.unlockScroll();
    }

    // Navigating away: the new page owns scroll and focus, so close without restoring either.
    dismiss = () => {
      if (!this.isOpen) return;
      this.isOpen = false;

      document.removeEventListener("keydown", this.handleCloseKeydown);
      document.removeEventListener("astro:before-swap", this.dismiss);
      this.previouslyFocused = null;

      this.dispatchEvent(new CustomEvent("overlay:closed"));
      this.render();
      this.unlockScroll(false);
    };

    toggle() {
      if (this.isOpen) {
        this.close();
      } else {
        this.open();
      }
    }

    render() {
      // Closed overlays stay in the DOM; keep their content out of the tab order and accessibility tree.
      this.inert = !this.isOpen;
      if (this.isOpen) {
        this.dataset.state = "open";
      } else {
        delete this.dataset.state;
      }
    }
  }

  customElements.define("overlay-root", OverlayElement);
</script>

<script>
  import type { OverlayElement } from "@lib/elements";

  const TRIGGERS = {
    "data-trigger-overlay-open": "open",
    "data-trigger-overlay-close": "close",
    "data-trigger-overlay-toggle": "toggle",
  } as const;

  const triggerSelector = Object.keys(TRIGGERS)
    .map((attribute) => `[${attribute}]`)
    .join(",");

  // Delegated so triggers rendered on later client-router pages work without rebinding.
  document.addEventListener("click", (event) => {
    const trigger = (event.target as Element | null)?.closest<HTMLElement>(triggerSelector);
    if (!trigger) return;

    for (const [attribute, action] of Object.entries(TRIGGERS)) {
      const overlayId = trigger.getAttribute(attribute);
      if (!overlayId) continue;

      const overlayRootElement = document.querySelector(
        `overlay-root[id="${overlayId}"]`,
      ) as OverlayElement | null;
      overlayRootElement?.[action]();
      return;
    }
  });
</script>

<style>
  overlay-root {
    position: fixed;
    z-index: 20;
    pointer-events: none;
  }

  overlay-root[data-state]:not([data-state="false"]) {
    z-index: 21;
    pointer-events: auto;
  }

  .backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity var(--transition-default);
  }

  overlay-root[data-state]:not([data-state="false"]) .backdrop {
    opacity: 1;
  }

  .panel {
    position: fixed;

    display: grid;
    grid-template-rows: auto 1fr;

    background-color: var(--color-background);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    outline: none;
  }

  .panel.fullscreen {
    top: 0;
    right: 0;
    height: 100%;
    width: 100%;
    padding: var(--s24);

    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-default);
  }
  overlay-root[data-state]:not([data-state="false"]) .panel.fullscreen {
    opacity: 1;
    pointer-events: auto;
  }
  @media (max-width: 32rem) {
    .panel.fullscreen {
      padding: var(--margin);
    }
  }

  .panel.right {
    top: 0;
    right: 0;
    height: 100%;
    width: 30rem;
    padding: var(--margin);

    transform: translateX(100%);
    transition: transform var(--transition-default);
  }
  overlay-root[data-state]:not([data-state="false"]) .panel.right {
    transform: translateX(0);
  }
  @media (max-width: 32rem) {
    .panel.right {
      top: auto;
      bottom: 0;

      width: 100%;
      height: calc(100svh - var(--s120));
      padding: var(--s20) var(--margin) var(--s40) var(--margin);

      border-top-left-radius: var(--border-radius);
      border-top-right-radius: var(--border-radius);

      transform: translateY(100%);
    }
    overlay-root[data-state]:not([data-state="false"]) .panel.right {
      transform: translateY(0);
    }
  }
</style>
