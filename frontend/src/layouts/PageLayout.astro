---
import "@styles/index.css";
import { INDEXABLE } from "astro:env/client";
import { ClientRouter } from "astro:transitions";
import Analytics from "@components/Analytics.astro";
import AnnouncementBanner from "@components/AnnouncementBanner.astro";
import Cart from "@components/cart/Cart.astro";
import CookiesBanner from "@components/CookiesBanner.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import LocationNotice from "@components/LocationNotice.astro";
import { THEME_COLOR } from "@config";
import PageTransition from "@decorations/PageTransition.astro";
import Grid from "@dev/Grid.astro";
import { getGlobals } from "@lib/sanity/globals";
import type { ResolvedMeta } from "@lib/sanity/meta";
import {
  buildOrganisationSchema,
  buildWebSiteSchema,
  type JsonLdSchema,
} from "@lib/sanity/structuredData";
import { getHtmlLang, getRenderLocale, localizeHref } from "@lib/shopify/locale";
import JsonLd from "@meta/JsonLd.astro";
import Meta from "@meta/Meta.astro";
import ScriptAnimations from "@scripts/ScriptAnimations.astro";
import ScriptMeasurements from "@scripts/ScriptMeasurements.astro";

interface Props {
  meta: ResolvedMeta | null | undefined;
  ogType?: "website" | "article" | "product";
  /* Page-level structured data. A prop because <slot /> renders inside <main>, not <head>. */
  jsonLd?: (JsonLdSchema | undefined)[];
  /* Pages that shouldn't appear in search results (e.g. search itself). */
  noindex?: boolean;
}

const { meta, ogType, jsonLd = [], noindex = false }: Props = Astro.props;

const locale = getRenderLocale(Astro);
// Other locales render the default locale's page, so Astro.url is the unprefixed path.
const pathname = localizeHref(Astro.url.pathname, locale);

const {
  header,
  footer,
  cart,
  metaSettings,
  organisationSettings,
  analyticsSettings,
  announcementBanner,
  cookieConsent,
  locationNotice,
} = await getGlobals();

const organisationSchema = buildOrganisationSchema(organisationSettings, Astro.site);
const webSiteSchema = buildWebSiteSchema(organisationSettings, Astro.site, locale);
---

<html
  lang={getHtmlLang(locale)}
  data-locale={locale.path}
  transition:name="root"
  transition:animate="none"
>
  <head>
    <ClientRouter />

    <meta charset="utf-8" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {organisationSettings?.name && (
      <meta name="apple-mobile-web-app-title" content={organisationSettings.name} />
    )}
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Meta
      meta={meta}
      metaSettings={metaSettings}
      locale={locale}
      pathname={pathname}
      siteName={organisationSettings?.name}
      organisationDescription={organisationSettings?.description}
      ogType={ogType}
      noindex={!INDEXABLE || noindex}
    />

    <JsonLd schema={organisationSchema} />
    <JsonLd schema={webSiteSchema} />
    {jsonLd.map((schema) => (
      <JsonLd schema={schema} />
    ))}

    <link
      rel="preload"
      href="/fonts/ArchivoNarrow-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <ScriptMeasurements />
    <ScriptAnimations />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>

    <div transition:persist="page-transition">
      <PageTransition />
    </div>

    <AnnouncementBanner announcementBanner={announcementBanner} />

    <div class="header-container" transition:persist="header">
      <Header header={header} />
    </div>

    <div transition:persist="cart">
      <Cart cart={cart} />
    </div>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <div transition:persist="consent">
      <CookiesBanner cookieConsent={cookieConsent} />
      <LocationNotice
        locationNotice={locationNotice}
        waitForConsent={Boolean(cookieConsent?.messageRaw)}
      />
      <Analytics analyticsSettings={analyticsSettings} />
    </div>

    <Footer footer={footer} />

    <Grid />
  </body>
</html>

<script>
  // The router swaps <main> without moving focus, leaving keyboard and screen reader users on the
  // old page's control. Only fires on navigation, never initial load.
  document.addEventListener("astro:after-swap", () => {
    document.getElementById("main")?.focus();
  });
</script>

<style>
  /* Header overlays the top of main; the announcement banner, when present, gets its own row. */
  /* minmax(0, …): a wide child (a carousel's slide strip) must never size the page. */
  body {
    display: grid;
    grid-template-rows: auto 1fr;
    grid-template-columns: minmax(0, 1fr);
  }

  :global(body > [data-announcement-banner]) {
    position: relative;
    z-index: 11;
    grid-area: 1 / 1 / 2 / 2;
  }

  body > .header-container {
    grid-area: 2 / 1 / 3 / 2;
  }

  body > main {
    grid-area: 2 / 1 / 3 / 2;
  }

  main:focus {
    outline: none;
  }

  .skip-link {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 100;
    padding: var(--size-3) var(--size-5);
    color: var(--color-background);
    background-color: var(--color-text);
    transform: translateY(-100%);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
