---
import "@styles/reset.css";
import "@styles/base.css";
import "@styles/colors.css";
import "@styles/spacing.css";
import "@styles/text.css";
import "@styles/elements.css";
import "@styles/forms.css";
import "@styles/animations.css";
import "@styles/fonts.css";

import { ClientRouter } from "astro:transitions";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Grid from "@dev/Grid.astro";
import Meta from "@meta/Meta.astro";
import JsonLd from "@meta/JsonLd.astro";
import { DEFAULT_LOCALE, LOCALE_CONFIG } from "@lib/shopify/locale";
import CookiesBanner from "@components/CookiesBanner.astro";
import AnnouncementBanner from "@components/AnnouncementBanner.astro";
import LocationNotice from "@components/LocationNotice.astro";
import Analytics from "@components/Analytics.astro";
import Cart from "@components/cart/Cart.astro";
import ScriptMeasurements from "@scripts/ScriptMeasurements.astro";
import ScriptAnimations from "@scripts/ScriptAnimations.astro";
import PageTransition from "@decorations/PageTransition.astro";
import { getGlobals } from "@lib/sanity/globals";
import type { ResolvedMeta } from "@lib/sanity/meta";
import {
  buildOrganisationSchema,
  buildWebSiteSchema,
  type JsonLdSchema,
} from "@lib/sanity/structuredData";
import { PREVIEW } from "astro:env/client";
import { THEME_COLOR } from "@config";

interface Props {
  metaData: ResolvedMeta | null | undefined;
  ogType?: "website" | "article" | "product";
  /* Page-level structured data. A prop because <slot /> renders inside <main>, not <head>. */
  jsonLd?: (JsonLdSchema | undefined)[];
}

const { metaData, ogType, jsonLd = [] }: Props = Astro.props;

// Static pages are market-neutral; the stored locale is applied client-side.
const currentLocale = DEFAULT_LOCALE;
const localeConfig = LOCALE_CONFIG[currentLocale];

const {
  headerData,
  footerData,
  cartData,
  metaSettingsData,
  organisationSettingsData,
  analyticsSettingsData,
  announcementBannerData,
  cookieConsentData,
  locationNoticeData,
} = await getGlobals();

const organisationSchema = buildOrganisationSchema(organisationSettingsData, Astro.site);
const webSiteSchema = buildWebSiteSchema(organisationSettingsData, Astro.site, currentLocale);

// The preview site is otherwise a fully indexable duplicate of live.
const isPreview = PREVIEW === "true";
if (isPreview) Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---

<html
  lang={currentLocale}
  data-locale={currentLocale}
  data-currency={localeConfig.currency}
  data-country={localeConfig.country}
  data-language={localeConfig.language}
  transition:name="root"
  transition:animate="none"
>
  <head>
    <ClientRouter />

    <meta charset="utf-8" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {organisationSettingsData?.name && (
      <meta name="apple-mobile-web-app-title" content={organisationSettingsData.name} />
    )}
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={THEME_COLOR} />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Meta
      metaData={metaData}
      metaSettingsData={metaSettingsData}
      locale={currentLocale}
      siteName={organisationSettingsData?.name}
      organisationDescription={organisationSettingsData?.description}
      ogType={ogType}
      noindex={isPreview}
    />

    <JsonLd schema={organisationSchema} />
    <JsonLd schema={webSiteSchema} />
    {jsonLd.map((schema) => (
      <JsonLd schema={schema} />
    ))}

    <link
      rel="preload"
      href="/fonts/BIZUDMincho-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <ScriptMeasurements />
    <ScriptAnimations />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>

    <div transition:persist="page-transition">
      <PageTransition />
    </div>

    <AnnouncementBanner announcementBannerData={announcementBannerData} />

    <div class="header-container" transition:persist="header">
      <Header headerData={headerData} />
    </div>

    <div transition:persist="cart">
      <Cart cartData={cartData} />
    </div>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <div transition:persist="consent">
      <CookiesBanner cookieConsentData={cookieConsentData} />
      <LocationNotice
        locationNoticeData={locationNoticeData}
        waitForConsent={Boolean(cookieConsentData?.messageRaw)}
      />
      <Analytics analyticsSettingsData={analyticsSettingsData} />
    </div>

    <Footer footerData={footerData} />

    <Grid />
  </body>
</html>

<script>
  // The router swaps <main> without moving focus, leaving keyboard and screen reader users on the
  // old page's control. Only fires on navigation, never initial load.
  document.addEventListener("astro:after-swap", () => {
    document.getElementById("main")?.focus();
  });
</script>

<style>
  /* Header overlays the top of main; the announcement banner, when present, gets its own row. */
  body {
    display: grid;
    grid-template-rows: auto 1fr;
  }

  :global(body > [data-announcement-banner]) {
    grid-area: 1 / 1 / 2 / 2;
    position: relative;
    z-index: 11;
  }

  body > .header-container {
    grid-area: 2 / 1 / 3 / 2;
  }

  body > main {
    grid-area: 2 / 1 / 3 / 2;
  }

  main:focus {
    outline: none;
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    padding: var(--s12) var(--s20);
    background-color: var(--color-text);
    color: var(--color-background);
    transform: translateY(-100%);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
