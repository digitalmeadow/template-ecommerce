---
import { getRenderLocale, LOCALE_LIST } from "@lib/shopify/locale";
import { getLocalization } from "@lib/shopify/localization";

const currentLocale = getRenderLocale(Astro);

// Only markets Shopify serves; the currency label is Shopify's, never configured.
const { availableCountries } = await getLocalization();
const localeOptions = LOCALE_LIST.flatMap((locale) => {
  const country = availableCountries.find((available) => available.isoCode === locale.country);
  return country
    ? [{ path: locale.path, label: `${locale.label} (${country.currency.isoCode})` }]
    : [];
});
---

{localeOptions.length > 1 && (
  <locale-selector class="g-select">
    <select aria-label="Select market">
      {localeOptions.map((option) => (
        <option value={option.path} selected={option.path === currentLocale.path}>
          {option.label}
        </option>
      ))}
    </select>
  </locale-selector>
)}

<script>
  import { getLocale, getPageLocale, switchLocale } from "@lib/shopify/locale";

  class LocaleSelectorElement extends HTMLElement {
    private select!: HTMLSelectElement;

    connectedCallback() {
      this.select = this.querySelector("select") as HTMLSelectElement;
      // The header persists across navigations; resync in case it was rendered for another page.
      this.select.value = getPageLocale().path;
      this.select.addEventListener("change", this.handleChange);
    }

    disconnectedCallback() {
      this.select.removeEventListener("change", this.handleChange);
    }

    private handleChange = () => {
      switchLocale(getLocale(this.select.value));
    };
  }

  customElements.define("locale-selector", LocaleSelectorElement);
</script>
