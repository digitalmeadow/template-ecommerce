---
import { LOCALE_CONFIG, getLocaleFromPath } from "@lib/shopify/locale";
import { getLocalization } from "@lib/shopify/localization";

const currentLocale = getLocaleFromPath(Astro.url.pathname);

const localization = await getLocalization();
const availableCountries = localization.availableCountries;

const localeOptions = Object.entries(LOCALE_CONFIG)
  .filter(([_, config]) =>
    availableCountries.some(
      (country) =>
        country.isoCode === config.country && country.currency.isoCode === config.currency,
    ),
  )
  .map(([locale, config]) => ({
    locale,
    label: `${config.label} (${config.currency})`,
    path: config.pathPrefix,
  }));
---

<locale-selector data-current={currentLocale}>
  <select aria-label="Select market">
    {
      localeOptions.map((option) => (
        <option
          value={option.locale}
          selected={option.locale === currentLocale}
          data-path={option.path ?? ""}
        >
          {option.label}
        </option>
      ))
    }
  </select>
</locale-selector>

<script>
  import { isValidLocale } from "@lib/shopify/locale";

  const LOCALE_STORAGE_KEY = "preferred-locale";

  export class LocaleSelectorElement extends HTMLElement {
    private select!: HTMLSelectElement;

    connectedCallback() {
      this.select = this.querySelector("select") as HTMLSelectElement;

      const storedLocale = localStorage.getItem(LOCALE_STORAGE_KEY);
      if (storedLocale && isValidLocale(storedLocale)) {
        this.select.value = storedLocale;
      }

      this.select.addEventListener("change", this.handleChange);
    }

    disconnectedCallback() {
      this.select.removeEventListener("change", this.handleChange);
    }

    private handleChange = () => {
      localStorage.setItem(LOCALE_STORAGE_KEY, this.select.value);
      window.location.reload();
    };
  }

  customElements.define("locale-selector", LocaleSelectorElement);
</script>
