---
interface Props {
  label: string;
  labelSubmitting?: string;
  labelSuccess?: string;
  /* Dimmed until the owning form sets [data-ready] (every required field filled). */
  mutedUntilReady?: boolean;
}

const {
  label,
  labelSubmitting = "Submitting",
  labelSuccess = "Submitted",
  mutedUntilReady,
}: Props = Astro.props;
---

<button
  class="button-submit g-button"
  type="submit"
  data-button-submit
  data-muted-until-ready={mutedUntilReady ? "" : undefined}
>
  <span class="label">{label}</span>
  <span class="label-submitting">{labelSubmitting}</span>
  <span class="label-success">{labelSuccess}</span>
</button>

<style>
  .button-submit {
    justify-content: center;
    transition:
      background-color var(--transition-default),
      color var(--transition-default),
      opacity var(--transition-default);
  }

  .button-submit[data-state="submitting"],
  .button-submit[data-muted-until-ready]:not([data-ready]) {
    opacity: var(--opacity-disabled);
  }

  .button-submit[data-state="submitting"] {
    pointer-events: none;
  }

  .label-submitting,
  .label-success,
  .button-submit:is([data-state="submitting"], [data-state="success"]) .label {
    display: none;
  }

  .button-submit[data-state="submitting"] .label-submitting,
  .button-submit[data-state="success"] .label-success {
    display: inline;
  }
</style>
