---
import type { HTMLAttributes } from "astro/types";
import { getHtmlLang, getRenderLocale } from "@lib/shopify/locale";
import { formatMoney } from "@lib/shopify/money";

interface Props extends HTMLAttributes<"span"> {
  kind?: "standard" | "compare-at";
  amount?: string;
  currency?: string;
  prefix?: string;
}

const { kind = "standard", amount, currency, prefix, ...attributes }: Props = Astro.props;

// Rendered into the static HTML, so prices never wait on JS.
const formatted =
  amount && currency ? formatMoney(amount, currency, getHtmlLang(getRenderLocale(Astro))) : "";
---

<price-display
  kind={kind}
  amount={amount}
  currency={currency}
  prefix={prefix}
  data-kind={kind}
  {...attributes}
>
  <span data-price-prefix>{prefix}</span>
  <span data-price-value>{formatted}</span>
</price-display>

<script>
  import { formatMoney } from "@lib/shopify/money";

  class PriceDisplayElement extends HTMLElement {
    private prefixElement!: HTMLSpanElement;
    private priceElement!: HTMLSpanElement;

    static observedAttributes = ["amount", "currency", "kind", "prefix"];

    connectedCallback() {
      this.prefixElement = this.querySelector("[data-price-prefix]")!;
      this.priceElement = this.querySelector("[data-price-value]")!;
    }

    attributeChangedCallback() {
      if (!this.prefixElement || !this.priceElement) return;
      this.updatePrice();
    }

    updatePrice() {
      const amount = this.getAttribute("amount");
      const currency = this.getAttribute("currency");
      const prefix = this.getAttribute("prefix");

      this.dataset.kind = this.getAttribute("kind") || "standard";
      this.prefixElement.textContent = prefix;
      this.priceElement.textContent =
        amount && currency ? formatMoney(amount, currency, document.documentElement.lang) : "";
    }
  }

  customElements.define("price-display", PriceDisplayElement);
</script>

<style>
  price-display {
    display: inline-flex;
    column-gap: 1ch;
  }

  price-display[hidden] {
    display: none;
  }

  price-display[data-kind="compare-at"] span {
    color: var(--color-text-muted);
    text-decoration-line: line-through;
  }

  [data-price-prefix]:empty {
    display: none;
  }
</style>
