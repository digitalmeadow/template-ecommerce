---
const columns = Array.from({ length: 16 });
---

<div id="grid-visualizer" style="display: none;">
  <div class="grid">
    {columns.map(() => (
      <div class="column" />
    ))}
  </div>
</div>

<style>
  .grid {
    position: fixed;
    top: 0;
    left: var(--margin);
    z-index: 100;
    display: grid;
    grid-template-columns: repeat(var(--column-count), 1fr);
    column-gap: var(--gutter);
    width: var(--container-width);
    height: 100vh;
    pointer-events: none;
    opacity: 0.12;
  }

  .column {
    width: 100%;
    height: 100%;
    background-color: var(--color-accent);
  }

  /* The grid has 4 columns below the breakpoint (tokens/grid.css). */
  @media (max-width: 48rem) {
    .column:nth-child(n + 5) {
      display: none;
    }
  }
</style>

<style is:global>
  body[data-outlined]:not([data-outlined="false"]) * {
    outline: 1px solid rgba(0, 0, 0, 0.1);
  }
</style>

<script>
  let visible = false;
  function handleKeyPress(event: KeyboardEvent) {
    if (event.ctrlKey && event.code === "KeyG") {
      visible = !visible;
      const gridVisualizerElement = document.getElementById("grid-visualizer");
      if (gridVisualizerElement) gridVisualizerElement.style.display = visible ? "block" : "none";
      if (visible) {
        document.body.dataset.outlined = "";
      } else {
        delete document.body.dataset.outlined;
      }
    }
  }
  window.addEventListener("keydown", handleKeyPress);
</script>
