<newsletter-signup>
  <form data-newsletter-form>
    <input
      type="text"
      name="email"
      placeholder="Enter your email"
      required
      aria-label="Email address"
    />
    <button type="submit" data-label="Subscribe"></button>
  </form>
  <p data-newsletter-message></p>
</newsletter-signup>

<script>
  import { z } from "astro/zod";

  const MESSAGE_TIMEOUT = 4000;

  const schema = z.object({
    email: z.email("Please enter a valid email address"),
  });

  class NewsletterSignupElement extends HTMLElement {
    private form!: HTMLFormElement;
    private message!: HTMLParagraphElement;
    private resetTimeout?: ReturnType<typeof setTimeout>;

    connectedCallback() {
      this.form = this.querySelector("[data-newsletter-form]")!;
      this.message = this.querySelector("[data-newsletter-message]")!;
      this.form.addEventListener("submit", this.handleSubmit);
    }

    disconnectedCallback() {
      this.form.removeEventListener("submit", this.handleSubmit);
      clearTimeout(this.resetTimeout);
    }

    private setState(state: "loading" | "success" | "error", text: string) {
      this.setAttribute("data-state", state);
      this.message.textContent = text;
    }

    private scheduleReset() {
      clearTimeout(this.resetTimeout);
      this.resetTimeout = setTimeout(() => {
        this.removeAttribute("data-state");
        this.message.textContent = "";
      }, MESSAGE_TIMEOUT);
    }

    private handleSubmit = async (e: SubmitEvent) => {
      e.preventDefault();

      const formData = new FormData(this.form);
      const parseResult = schema.safeParse({
        email: formData.get("email"),
      });

      if (!parseResult.success) {
        this.setState("error", parseResult.error.issues[0].message);
        this.scheduleReset();
        return;
      }

      this.setState("loading", "");

      try {
        /*
        // Example: Mailchimp via server endpoint
        const response = await fetch('/api/newsletter/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        if (!response.ok) throw new Error('Failed to subscribe');
        */

        // Simulate demo
        await new Promise((resolve) => setTimeout(resolve, 1000));

        this.setState("success", "Thanks for subscribing!");
        this.form.reset();
      } catch (error) {
        this.setState("error", "Something went wrong. Please try again.");
        console.error("Newsletter signup error:", error);
      }

      this.scheduleReset();
    };
  }

  customElements.define("newsletter-signup", NewsletterSignupElement);
</script>

<style>
  button::before {
    content: attr(data-label);
  }

  newsletter-signup[data-state="loading"] button {
    opacity: 0.5;
    cursor: wait;
  }

  newsletter-signup[data-state="loading"] button::before {
    content: "Subscribing...";
  }

  newsletter-signup[data-state="success"] button::before {
    content: "Subscribed";
  }

  newsletter-signup[data-state="error"] button {
    opacity: 0.5;
  }

  newsletter-signup[data-state="success"] [data-newsletter-message] {
    color: green;
  }

  newsletter-signup[data-state="error"] [data-newsletter-message] {
    color: red;
  }
</style>
