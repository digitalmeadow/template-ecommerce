---
import type { CookieConsentFragment } from "sanity/generated/graphql";
import PortableText from "@fields/PortableText.astro";

interface Props {
  cookieConsentData: CookieConsentFragment | null | undefined;
}

// No consent copy means no banner, so analytics never load: the safe failure.
const { cookieConsentData }: Props = Astro.props;
---

{cookieConsentData?.messageRaw && (
  <cookie-banner>
    <div class="cookie-banner" data-banner>
      <PortableText value={cookieConsentData.messageRaw} />
      <div class="actions" data-actions>
        <button class="text-link underline-color-orange" type="button" data-decline-button>
          {cookieConsentData.declineLabel}
        </button>
        <button class="text-link underline-color-green" type="button" data-accept-button>
          {cookieConsentData.acceptLabel}
        </button>
      </div>
    </div>
  </cookie-banner>
)}

<script>
  import { getConsent, setConsent } from "@lib/consent/consent";

  class CookieBannerElement extends HTMLElement {
    private banner!: HTMLElement;
    private acceptButton!: HTMLButtonElement;
    private declineButton!: HTMLButtonElement;

    connectedCallback() {
      this.banner = this.querySelector("[data-banner]")!;
      this.acceptButton = this.querySelector("[data-accept-button]")!;
      this.declineButton = this.querySelector("[data-decline-button]")!;

      this.acceptButton.addEventListener("click", this.handleAccept);
      this.declineButton.addEventListener("click", this.handleDecline);

      if (getConsent() === null) {
        this.show();
      } else {
        this.hide();
      }
    }

    disconnectedCallback() {
      this.acceptButton.removeEventListener("click", this.handleAccept);
      this.declineButton.removeEventListener("click", this.handleDecline);
    }

    show() {
      this.dataset.visible = "";
      this.banner.setAttribute("aria-hidden", "false");
    }

    hide() {
      delete this.dataset.visible;
      this.banner.setAttribute("aria-hidden", "true");
    }

    handleAccept = () => {
      setConsent("accepted");
      this.hide();
    };

    handleDecline = () => {
      setConsent("declined");
      this.hide();
    };
  }

  customElements.define("cookie-banner", CookieBannerElement);
</script>

<style>
  cookie-banner {
    display: none;
  }

  cookie-banner[data-visible] {
    display: block;
  }

  .cookie-banner {
    position: fixed;
    z-index: 5;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: var(--margin) var(--margin-dynamic);

    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;

    background-color: var(--color-background);
  }

  .actions {
    display: flex;
    gap: var(--s16);
    flex-wrap: wrap;
  }
</style>
