---
import type { FooterFragment } from "sanity/generated/graphql";
import LocaleSelector from "@blocks/LocaleSelector.astro";
import SanityLink from "@fields/SanityLink.astro";
import { getRenderLocale, localizeHref } from "@lib/shopify/locale";
import { getShopPolicies } from "@lib/shopify/shop";

interface Props {
  footer: FooterFragment | null | undefined;
}

const { footer }: Props = Astro.props;

const locale = getRenderLocale(Astro);
const policies = await getShopPolicies(locale);
---

<footer class="footer g-page-margin">
  <nav aria-label="Footer">
    <ul>
      {footer?.navigationItems?.map((navigationItem) => {
        if (!navigationItem?.link) return null;
        return (
          <li>
            <SanityLink link={navigationItem.link} class="g-text-link-hover">
              {navigationItem.label}
            </SanityLink>
          </li>
        );
      })}
      {policies.map((policy) => (
        <li>
          <a href={localizeHref(`/policies/${policy.handle}`, locale)} class="g-text-link-hover">
            {policy.title}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <LocaleSelector />
</footer>

<style>
  .footer {
    margin-top: var(--section-space-lg);
    padding-block: var(--size-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-3) var(--gutter);
    align-items: center;
    justify-content: space-between;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--size-1) var(--size-5);
  }
</style>
