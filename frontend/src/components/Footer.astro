---
import type { FooterFragment } from "sanity/generated/graphql";
import PortableText from "@fields/PortableText.astro";
import SanityLink from "@fields/SanityLink.astro";
import SanityMedia from "@fields/SanityMedia.astro";

interface Props {
  footerData: FooterFragment | null | undefined;
}

const { footerData }: Props = Astro.props;
---

<footer class="u-container">
  <div class="footer-content">
    <PortableText value={footerData?.textRaw} />

    <div class="nav">
      {
        footerData?.navigationItems?.map((navigationItem) => {
          if (!navigationItem?.link) return null;
          return <SanityLink linkData={navigationItem.link}>{navigationItem.label}</SanityLink>;
        })
      }
    </div>
  </div>

  <!-- <NewsletterSignup /> -->
</footer>

<div class="media">
  <div class="media-inner">
    <SanityMedia mediaData={footerData?.mediaBackground} layout="width" />
  </div>
</div>

<style>
  footer {
    position: relative;

    padding: var(--s200) 0 0;
  }

  .media {
    width: 100%;
    height: auto;
    overflow: hidden;
    display: flex;
    justify-content: center;
  }

  .media-inner {
    width: 120%;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    text-align: center;
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s8);
  }
</style>
