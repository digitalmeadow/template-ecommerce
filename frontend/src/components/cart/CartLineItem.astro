---
import PriceDisplay from "@blocks/PriceDisplay.astro";
import QuantitySelector from "@blocks/QuantitySelector.astro";
---

<cart-line-item>
  <div class="cart-line-item">
    <a data-link class="thumbnail">
      <img data-image alt="" />
    </a>

    <div class="info">
      <a data-link class="title-link">
        <div class="titles">
          <span class="product-title" data-title></span>
          <span class="variant-title" data-variant-title></span>
        </div>
      </a>

      <div class="inventory">
        <QuantitySelector data-quantity-selector />
        <button
          class="remove-button g-text-link g-underline-orange"
          type="button"
          data-remove-button
          aria-label="Remove item from cart"
        >
          Remove
        </button>
      </div>

      <p class="line-message g-form-error" role="status" data-line-message></p>

      <div class="prices">
        <div data-compare-at-wrapper hidden>
          <PriceDisplay variant="compare-at" data-compare-at-price />
        </div>
        <PriceDisplay data-price />
      </div>
    </div>
  </div>
</cart-line-item>

<script>
  import { resolveSanityHref } from "@lib/sanity/resolve";
  import { getPageLocale, localizeHref } from "@lib/shopify/locale";
  import { updateLineQuantity, removeLine } from "@stores/cart";
  import { DEFAULT_VARIANT_TITLE } from "@lib/shopify/variants";
  import type { EventQuantityChanged } from "@lib/events";
  import type { CartLineFragment } from "shopify/generated/graphql";
  import type { CartMessage } from "@lib/shopify/cartActions";

  class CartLineItemElement extends HTMLElement {
    linkElements: NodeListOf<HTMLAnchorElement> | undefined;
    imageElement!: HTMLImageElement;
    titleElement!: HTMLElement;
    variantTitleElement!: HTMLElement;
    removeButton!: HTMLButtonElement;
    quantitySelector!: HTMLElement;
    messageElement!: HTMLElement;

    priceDisplay!: HTMLElement;
    compareAtWrapper!: HTMLElement;
    compareAtDisplay!: HTMLElement;

    line?: CartLineFragment;
    messages: CartMessage[] = [];

    init(line: CartLineFragment, messages: CartMessage[]) {
      this.line = line;
      this.messages = messages;
      this.render();
    }

    connectedCallback() {
      this.linkElements = this.querySelectorAll("[data-link]");
      this.imageElement = this.querySelector("[data-image]")!;
      this.titleElement = this.querySelector("[data-title]")!;
      this.variantTitleElement = this.querySelector("[data-variant-title]")!;
      this.removeButton = this.querySelector("[data-remove-button]")!;
      this.quantitySelector = this.querySelector("quantity-selector")!;
      this.messageElement = this.querySelector("[data-line-message]")!;

      this.priceDisplay = this.querySelector("[data-price]")!;
      this.compareAtWrapper = this.querySelector("[data-compare-at-wrapper]")!;
      this.compareAtDisplay = this.querySelector("[data-compare-at-price]")!;

      this.removeButton.addEventListener("click", this.handleRemove);
      this.addEventListener("quantity-selector:quantity-changed", this.handleQuantityChange);
    }

    disconnectedCallback() {
      this.removeButton.removeEventListener("click", this.handleRemove);
      this.removeEventListener("quantity-selector:quantity-changed", this.handleQuantityChange);
    }

    setPending(isPending: boolean) {
      this.toggleAttribute("data-pending", isPending);
      this.removeButton.disabled = isPending;
    }

    private render() {
      if (!this.line) return;

      const { merchandise, quantity, cost, id } = this.line;
      const { product, title: variantTitle, image: variantImage, quantityAvailable } = merchandise;

      this.dataset.lineId = id;

      const href = localizeHref(resolveSanityHref("product", product.handle), getPageLocale());
      for (const linkElement of this.linkElements!) {
        linkElement.href = href;
      }

      this.titleElement.textContent = product.title;
      this.variantTitleElement.textContent = variantTitle;

      this.dataset.singleDefaultVariant = String(variantTitle === DEFAULT_VARIANT_TITLE);

      const imageUrl = variantImage?.thumbnailUrl ?? product.featuredImage?.thumbnailUrl;
      if (imageUrl) {
        this.imageElement.src = imageUrl;
        this.imageElement.dataset.loaded = "true";
      }

      this.quantitySelector.setAttribute("initial", String(quantity));
      // Null when inventory isn't tracked or the token can't read it.
      if (quantityAvailable != null && quantityAvailable > 0) {
        this.quantitySelector.setAttribute("max", String(Math.max(quantityAvailable, quantity)));
      }

      this.priceDisplay.setAttribute("amount", cost.totalAmount.amount);
      this.priceDisplay.setAttribute("currency", cost.totalAmount.currencyCode);

      const compareAt = cost.compareAtAmountPerQuantity;
      const isDiscounted =
        !!compareAt && Number(compareAt.amount) > Number(cost.amountPerQuantity.amount);
      if (compareAt && isDiscounted) {
        this.compareAtDisplay.setAttribute("amount", String(Number(compareAt.amount) * quantity));
        this.compareAtDisplay.setAttribute("currency", compareAt.currencyCode);
      }
      this.compareAtWrapper.hidden = !isDiscounted;

      this.messageElement.textContent = this.messages.map((message) => message.message).join(" ");
    }

    private handleRemove = () => {
      if (this.line) removeLine(this.line.id);
    };

    private handleQuantityChange = (event: Event) => {
      if (this.line) updateLineQuantity(this.line.id, (event as EventQuantityChanged).detail.value);
    };
  }

  customElements.define("cart-line-item", CartLineItemElement);
</script>

<style>
  cart-line-item {
    display: block;
    width: 100%;
  }

  .cart-line-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--gutter);
  }

  .thumbnail {
    width: var(--size-16);
    height: var(--size-16);
    background-color: var(--color-surface);
  }

  [data-image] {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--transition-media);
  }

  [data-image][data-loaded]:not([data-loaded="false"]) {
    opacity: 1;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: var(--size-1);
  }

  .titles {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1ch;
  }

  cart-line-item[data-single-default-variant]:not([data-single-default-variant="false"])
    .variant-title {
    display: none;
  }

  .variant-title {
    color: var(--color-text-muted);
  }

  .inventory {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--size-4);
  }

  .remove-button {
    align-self: start;
  }

  cart-line-item[data-pending] [data-price] {
    opacity: var(--opacity-disabled);
  }

  .line-message:empty {
    display: none;
  }
</style>
