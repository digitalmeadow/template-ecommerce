---
import PriceDisplay from "@blocks/PriceDisplay.astro";
import Overlay from "@layouts/Overlay.astro";
import CartLineItem from "./CartLineItem.astro";
import type { CartFragment } from "sanity/generated/graphql";
import PortableText from "@fields/PortableText.astro";
import { getRenderLocale } from "@lib/shopify/locale";

interface Props {
  cartData: CartFragment | null | undefined;
}

const { cartData }: Props = Astro.props;

const localePath = getRenderLocale(Astro).path;
---

<cart-drawer>
  <Overlay id="cart" layout="right" aria-label="Shopping Cart">
    <div class="header" slot="header">
      <h2 class="g-heading-5">
        Your Cart <span data-cart-count></span>
      </h2>
    </div>

    <aside class="cart" data-cart data-state="empty" slot="content">
      <template data-cart-line-template>
        <li>
          <CartLineItem />
        </li>
      </template>

      <template data-cart-code-template>
        <li class="applied-code">
          <span data-code-label></span>
          <button class="g-text-link g-underline-orange" type="button" data-code-remove>
            Remove
          </button>
        </li>
      </template>

      <div class="cart-content">
        <div class="empty-message">
          <PortableText value={cartData?.emptyMessageRaw} />
        </div>

        <ul class="cart-line-items" data-cart-line-items></ul>

        <div class="codes">
          <form class="code-form" method="post" action="/api/cart" data-discount-form>
            <input type="hidden" name="locale" value={localePath} />
            <input type="hidden" name="intent" value="discount-apply" />
            <label class="code-field g-form-field">
              <span class="g-sr-only">Discount code</span>
              <input type="text" name="code" placeholder="Discount code" autocomplete="off" />
            </label>
            <button class="g-text-link" type="submit">
              Apply
            </button>
          </form>
          <ul class="applied-codes" data-discount-codes></ul>

          <form class="code-form" method="post" action="/api/cart" data-gift-card-form>
            <input type="hidden" name="locale" value={localePath} />
            <input type="hidden" name="intent" value="gift-card-apply" />
            <label class="code-field g-form-field">
              <span class="g-sr-only">Gift card</span>
              <input type="text" name="code" placeholder="Gift card" autocomplete="off" />
            </label>
            <button class="g-text-link" type="submit">
              Apply
            </button>
          </form>
          <ul class="applied-codes" data-gift-cards></ul>
        </div>

        <label class="g-form-field">
          <span>Order note</span>
          <textarea name="note" rows="2" data-cart-note-input></textarea>
        </label>

        <div data-cart-total>
          <span>
            Total:&nbsp;
            <PriceDisplay />
          </span>
        </div>

        <div class="footer">
          <p class="cart-error g-form-error" role="alert" data-cart-error></p>

          <div data-cart-note>
            <PortableText value={cartData?.noteRaw} />
          </div>

          <a class="checkout-button g-text-link" href="/checkout" data-cart-checkout>
            Checkout
          </a>
        </div>
      </div>
    </aside>
  </Overlay>
</cart-drawer>

<script>
  import {
    $cart,
    $cartCount,
    $cartLines,
    $cartMessages,
    $cartPending,
    $cartTotal,
    applyDiscountCode,
    applyGiftCard,
    loadCart,
    removeDiscountCode,
    removeGiftCard,
    updateNote,
  } from "@stores/cart";
  import { $cartOpen, setCartOpen } from "@stores/ui";
  import type { CartLineItemElement, OverlayElement } from "@lib/elements";
  import type { CartFragment, MoneyFragment } from "shopify/generated/graphql";
  import type { CartMessage } from "@lib/shopify/cartActions";
  import { trackBeginCheckout, trackCartView } from "@lib/analytics/track";

  class CartDrawerElement extends HTMLElement {
    private cartElement!: HTMLElement;
    private countElement!: HTMLElement;
    private lineItemsContainer!: HTMLUListElement;
    private discountCodesContainer!: HTMLUListElement;
    private giftCardsContainer!: HTMLUListElement;
    private discountForm!: HTMLFormElement;
    private giftCardForm!: HTMLFormElement;
    private noteInput!: HTMLTextAreaElement;
    private checkoutLink!: HTMLAnchorElement;
    private totalPriceDisplay!: HTMLElement;
    private errorElement!: HTMLElement;
    private lineTemplate!: HTMLTemplateElement;
    private codeTemplate!: HTMLTemplateElement;
    private overlayElement!: OverlayElement;
    private unsubscribes: (() => void)[] = [];

    connectedCallback() {
      this.cartElement = this.querySelector("[data-cart]")!;
      this.countElement = this.querySelector("[data-cart-count]")!;
      this.lineItemsContainer = this.querySelector("[data-cart-line-items]")!;
      this.discountCodesContainer = this.querySelector("[data-discount-codes]")!;
      this.giftCardsContainer = this.querySelector("[data-gift-cards]")!;
      this.discountForm = this.querySelector("[data-discount-form]")!;
      this.giftCardForm = this.querySelector("[data-gift-card-form]")!;
      this.noteInput = this.querySelector("[data-cart-note-input]")!;
      this.checkoutLink = this.querySelector("[data-cart-checkout]")!;
      this.totalPriceDisplay = this.querySelector("[data-cart-total] price-display")!;
      this.errorElement = this.querySelector("[data-cart-error]")!;
      this.lineTemplate = this.querySelector("[data-cart-line-template]")!;
      this.codeTemplate = this.querySelector("[data-cart-code-template]")!;
      this.overlayElement = this.querySelector("overlay-root")!;

      this.unsubscribes = [
        $cart.subscribe(this.renderCart),
        $cartMessages.subscribe(this.renderCart),
        $cartPending.subscribe(this.renderPending),
        $cartCount.subscribe(this.renderCount),
        $cartTotal.subscribe(this.renderTotal),
        $cartOpen.subscribe(this.handleOpenChange),
      ];

      this.discountForm.addEventListener("submit", this.handleDiscountSubmit);
      this.giftCardForm.addEventListener("submit", this.handleGiftCardSubmit);
      this.noteInput.addEventListener("change", this.handleNoteChange);
      this.checkoutLink.addEventListener("click", this.handleCheckoutClick);
      this.overlayElement.addEventListener("overlay:closed", this.handleOverlayClosed);
    }

    disconnectedCallback() {
      this.unsubscribes.forEach((unsubscribe) => unsubscribe());
      this.unsubscribes = [];
      this.discountForm.removeEventListener("submit", this.handleDiscountSubmit);
      this.giftCardForm.removeEventListener("submit", this.handleGiftCardSubmit);
      this.noteInput.removeEventListener("change", this.handleNoteChange);
      this.checkoutLink.removeEventListener("click", this.handleCheckoutClick);
      this.overlayElement.removeEventListener("overlay:closed", this.handleOverlayClosed);
    }

    private handleOverlayClosed = () => setCartOpen(false);

    // Subscribing fires immediately, possibly before the overlay is upgraded.
    private handleOpenChange = async (isOpen: boolean) => {
      await customElements.whenDefined("overlay-root");
      if (isOpen) {
        this.overlayElement.open();
        trackCartView($cart.get());
      } else {
        this.overlayElement.close();
      }
    };

    private handleCheckoutClick = () => trackBeginCheckout($cart.get());

    private handleDiscountSubmit = async (event: SubmitEvent) => {
      event.preventDefault();
      const code = readCode(this.discountForm);
      if (!code) return;
      const result = await applyDiscountCode(code);
      if (result && !result.messages.length) this.discountForm.reset();
    };

    private handleGiftCardSubmit = async (event: SubmitEvent) => {
      event.preventDefault();
      const code = readCode(this.giftCardForm);
      if (!code) return;
      const result = await applyGiftCard(code);
      if (result && !result.messages.length) this.giftCardForm.reset();
    };

    private handleNoteChange = () => {
      if (this.noteInput.value !== ($cart.get()?.note ?? "")) updateNote(this.noteInput.value);
    };

    private renderCount = (count: number) => {
      this.countElement.textContent = `(${count})`;
    };

    private renderTotal = (total: MoneyFragment | null) => {
      if (total) {
        this.totalPriceDisplay.setAttribute("amount", total.amount);
        this.totalPriceDisplay.setAttribute("currency", total.currencyCode);
      } else {
        this.totalPriceDisplay.removeAttribute("amount");
      }
    };

    private renderPending = (pending: ReadonlySet<string>) => {
      this.cartElement.toggleAttribute("data-pending", pending.size > 0);
      this.discountForm.toggleAttribute("data-pending", pending.has("discount"));
      this.giftCardForm.toggleAttribute("data-pending", pending.has("gift-card"));
      for (const lineItem of this.lineItemsContainer.querySelectorAll<CartLineItemElement>(
        "cart-line-item",
      )) {
        lineItem.setPending(pending.has(lineItem.dataset.lineId ?? ""));
      }
    };

    private renderCart = () => {
      const cart = $cart.get();
      const lines = $cartLines.get();
      const messages = $cartMessages.get();

      const cartMessages = messages
        .filter((message) => !message.lineId && !message.discountCode)
        .map((message) => message.message);
      this.errorElement.textContent = [...new Set(cartMessages)].join(" ");

      this.cartElement.dataset.state = cart && lines.length ? "loaded" : "empty";

      this.lineItemsContainer.replaceChildren(
        ...lines.map((line) => {
          const clone = this.lineTemplate.content.cloneNode(true) as DocumentFragment;
          const lineItemElement = clone.querySelector("cart-line-item") as CartLineItemElement;
          const lineMessages = messages.filter((message) => message.lineId === line.id);
          customElements
            .whenDefined("cart-line-item")
            .then(() => lineItemElement.init(line, lineMessages));
          return clone;
        }),
      );

      this.renderCodes(cart, messages);
      if (document.activeElement !== this.noteInput) this.noteInput.value = cart?.note ?? "";
      this.renderPending($cartPending.get());
    };

    private renderCodes(cart: CartFragment | null, messages: CartMessage[]) {
      this.discountCodesContainer.replaceChildren(
        ...(cart?.discountCodes ?? []).map((discountCode) => {
          const message = messages.find((item) => item.discountCode === discountCode.code);
          const label = discountCode.applicable
            ? discountCode.code
            : `${discountCode.code} (${message?.message ?? "not applicable"})`;
          return this.codeItem(label, () => removeDiscountCode(discountCode.code));
        }),
      );
      this.giftCardsContainer.replaceChildren(
        ...(cart?.appliedGiftCards ?? []).map((giftCard) =>
          this.codeItem(`Gift card •••• ${giftCard.lastCharacters}`, () =>
            removeGiftCard(giftCard.id),
          ),
        ),
      );
    }

    private codeItem(label: string, remove: () => void): DocumentFragment {
      const clone = this.codeTemplate.content.cloneNode(true) as DocumentFragment;
      clone.querySelector("[data-code-label]")!.textContent = label;
      clone.querySelector("[data-code-remove]")!.addEventListener("click", remove, { once: true });
      return clone;
    }
  }

  function readCode(form: HTMLFormElement): string {
    return String(new FormData(form).get("code") ?? "").trim();
  }

  customElements.define("cart-drawer", CartDrawerElement);

  // Module scripts run once, so the persisted cart loads once per visit, not per navigation.
  loadCart();
</script>

<style>
  cart-drawer {
    display: contents;
  }

  .cart {
    height: 100%;
  }

  .header {
    margin-bottom: var(--size-10);
  }

  .cart-content {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--size-10);
  }

  .cart-line-items {
    display: flex;
    flex-direction: column;
    gap: var(--size-6);
  }

  .codes {
    display: flex;
    flex-direction: column;
    gap: var(--size-3);
  }

  .code-form {
    display: flex;
    align-items: center;
    gap: var(--size-3);
  }

  .code-field {
    flex: 1;
  }

  .code-form[data-pending] {
    opacity: var(--opacity-disabled);
    pointer-events: none;
  }

  .applied-code {
    display: flex;
    gap: var(--size-3);
  }

  .footer {
    margin-top: auto;
  }

  .checkout-button {
    display: inline-block;
    margin-top: var(--size-10);
  }

  .applied-codes:empty,
  .cart-error:empty,
  .empty-message {
    display: none;
  }

  [data-cart][data-state="empty"] .empty-message {
    display: block;
  }

  [data-cart][data-state="empty"]
    :is(.cart-line-items, .codes, .g-form-field, [data-cart-total], [data-cart-checkout]) {
    display: none;
  }

  [data-cart][data-pending] [data-cart-checkout] {
    opacity: var(--opacity-disabled);
    pointer-events: none;
  }
</style>
