---
import type { HeaderFragment } from "sanity/generated/graphql";
import LocaleSelector from "@blocks/LocaleSelector.astro";
import SearchForm from "@blocks/SearchForm.astro";
import SanityLink from "@fields/SanityLink.astro";
import { resolveSanityLink } from "@lib/sanity/links";
import { getRenderLocale, localizeHref } from "@lib/shopify/locale";
import { getCustomerAccountUrl } from "@lib/shopify/shop";
import LogoSvg from "@svgs/logo.svg";
import CartButton from "./cart/CartButton.astro";

interface Props {
  header: HeaderFragment | null | undefined;
}

const { header }: Props = Astro.props;
const locale = getRenderLocale(Astro);

const underlineStyles = [
  "g-underline-orange",
  "g-underline-yellow",
  "g-underline-green",
  "g-underline-blue",
  "g-underline-purple",
];
---

<header class="header g-page-margin">
  <div class="background" data-header></div>

  <div class="tools">
    <SearchForm />
    <LocaleSelector />
  </div>

  <a class="logo" href={localizeHref("/", locale)} aria-label="Home">
    <LogoSvg />
  </a>

  <nav>
    {header?.navigationItems?.map(async (navigationItem, index) => {
      if (!navigationItem?.link) return null;
      const href = (await resolveSanityLink(navigationItem.link))?.href;
      const isActive = Astro.url.pathname === href;
      return (
        <div class="nav-item">
          <SanityLink
            class:list={["g-text-link", underlineStyles[index % underlineStyles.length]]}
            data-active={isActive}
            link={navigationItem.link}
          >
            {navigationItem.label}
          </SanityLink>
        </div>
      );
    })}
  </nav>

  <div class="shop-links">
    <a class="search-link" href={localizeHref("/search", locale)}>
      Search
    </a>
    <a class="account-link" href={await getCustomerAccountUrl()}>
      Account
    </a>
    <CartButton />
  </div>
</header>

<script>
  // The header persists across client-router navigations, so its server-rendered active state
  // would go stale; re-derive it from the URL on every page load.
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLAnchorElement>(".header nav a[href]").forEach((link) => {
      link.dataset.active = String(link.pathname === window.location.pathname);
    });
  });
</script>

<style>
  .header {
    position: relative;
    z-index: 10;
    padding-block: var(--margin) var(--section-space-lg);
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    pointer-events: none;
  }

  .background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--size-16);
    background-color: var(--color-background);
  }

  /* One row height (a form control's), so search, links and cart line up. */
  .tools,
  .shop-links,
  nav {
    position: sticky;
    top: var(--margin);
    min-height: var(--size-10);
    display: flex;
    gap: var(--size-4);
    align-items: center;
    pointer-events: auto;
  }

  .shop-links {
    justify-self: end;
  }

  .search-link {
    display: none;
  }

  .logo {
    position: relative;
    margin-bottom: var(--size-6);
    width: var(--size-12);
    aspect-ratio: 438 / 405;
    grid-area: 1 / 2 / 2 / 3;
    justify-self: center;
    pointer-events: auto;
  }

  nav {
    margin-top: var(--size-20);
    flex-wrap: wrap;
    grid-area: 1 / 2 / 2 / 3;
    justify-self: center;
  }

  @media (max-width: 48rem) {
    .header {
      grid-template-columns: 1fr auto;
    }

    .background {
      height: var(--size-10);
    }

    /* Phones search from /search and switch market from the footer. */
    .tools {
      display: none;
    }

    .search-link {
      display: inline;
    }

    .shop-links {
      grid-area: 1 / 2 / 2 / 3;
    }

    .logo,
    nav {
      grid-area: 1 / 1 / 2 / 2;
      justify-self: start;
    }
  }
</style>
