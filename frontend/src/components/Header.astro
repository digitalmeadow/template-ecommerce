---
import type { HeaderFragment } from "sanity/generated/graphql";
import SanityLink from "@fields/SanityLink.astro";
import LogoSvg from "@svgs/logo.svg";
import LocaleSelector from "@blocks/LocaleSelector.astro";
import CartButton from "./cart/CartButton.astro";
import { resolveSanityLink } from "@lib/sanity/links";

interface Props {
  headerData: HeaderFragment | null | undefined;
}

const { headerData }: Props = Astro.props;

const underlineStyles = [
  "underline-color-orange",
  "underline-color-yellow",
  "underline-color-green",
  "underline-color-blue",
  "underline-color-purple",
];
---

<header class="u-container">
  <div class="background"></div>

  <div class="locale-selector">
    <LocaleSelector />
  </div>

  <a class="logo" href="/" aria-label="Home">
    <LogoSvg />
  </a>

  <nav>
    {
      headerData?.navigationItems?.map(async (navigationItem, index) => {
        if (!navigationItem?.link) return null;
        const href = (await resolveSanityLink(navigationItem.link))?.href;
        const isActive = Astro.url.pathname === href;
        return (
          <div
            class:list={[
              "nav-item",
              {
                collection:
                  navigationItem.link?.type === "page" &&
                  navigationItem.link?.page?._type === "collection",
              },
            ]}
          >
            <SanityLink
              class:list={["text-link", underlineStyles[index % underlineStyles.length]]}
              data-active={isActive}
              linkData={navigationItem.link}
            >
              {navigationItem.label}
            </SanityLink>
          </div>
        );
      })
    }
  </nav>

  <div class="cart-button">
    <CartButton />
  </div>
</header>

<script>
  // The header persists across client-router navigations, so its server-rendered active state
  // would go stale; re-derive it from the URL on every page load.
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLAnchorElement>("header nav a[href]").forEach((link) => {
      link.dataset.active = String(link.pathname === window.location.pathname);
    });
  });
</script>

<style>
  header {
    position: relative;
    z-index: 10;

    height: 100%;

    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    padding: var(--margin) 0 var(--s120);

    pointer-events: none;
  }
  @media (max-width: 64rem) {
    header {
      padding: var(--s16) 0 var(--s120);
    }
  }
  @media (max-width: 32rem) {
    header {
      grid-template-columns: 1fr auto;
    }
  }

  .background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 64px;
    background-color: var(--color-background);
  }
  @media (max-width: 64rem) {
    .background {
      height: 40px;
    }
  }

  .locale-selector {
    position: sticky;
    top: var(--margin);
    pointer-events: auto;
  }
  @media (max-width: 64rem) {
    .locale-selector {
      top: var(--s16);
    }
  }
  @media (max-width: 32rem) {
    .locale-selector {
      display: none;
    }
  }

  .cart-button {
    position: sticky;
    top: var(--margin);
    justify-self: end;
    pointer-events: auto;
  }
  @media (max-width: 64rem) {
    .cart-button {
      top: var(--s16);
    }
  }
  @media (max-width: 32rem) {
    .cart-button {
      grid-area: 1 / 2 / 2 / 3;
    }
  }

  .logo {
    position: relative;

    grid-area: 1 / 2 / 2 / 3;
    justify-self: center;
    width: 48px;
    aspect-ratio: 438 / 405;
    margin-bottom: var(--s24);
    pointer-events: auto;
  }
  @media (max-width: 32rem) {
    .logo {
      grid-area: 1 / 1 / 2 / 2;
      justify-self: start;
    }
  }

  nav {
    grid-area: 1 / 2 / 2 / 3;
    justify-self: center;

    position: sticky;
    top: var(--margin);

    margin-top: var(--s80);

    display: flex;
    flex-wrap: wrap;
    gap: var(--s16);
    pointer-events: auto;
  }
  @media (max-width: 64rem) {
    nav {
      top: var(--s16);
    }
  }
  @media (max-width: 32rem) {
    nav {
      grid-area: 1 / 1 / 2 / 2;
      justify-self: start;
    }
  }
</style>
