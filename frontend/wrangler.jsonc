{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "template-ecommerce",
  "account_id": "8302c7b161e88da77559f1fc976201c3",
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Capped by the workerd that miniflare bundles for prerendering; raising this past it fails
  // the build, not just the deploy.
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
  },
  "observability": {
    "logs": {
      "enabled": true,
    },
  },
  // Every `context: "client"` var in astro.config.mjs is inlined at build time, so only the
  // server secrets below are read at runtime. `secrets.required` fails the deploy if the Worker
  // lacks them; it isn't inherited, so it's repeated per environment.
  // Each env is its own Worker, selected by the `CLOUDFLARE_ENV` build variable.
  "env": {
    "production": {
      "secrets": {
        "required": [
          "SANITY_VIEWER_API_TOKEN",
          "SANITY_EDITOR_API_TOKEN",
          "SHOPIFY_SANITY_SYNC_SECRET",
          "SHOPIFY_PRIVATE_API_TOKEN",
        ],
      },
      // Once a custom domain is attached, add `"workers_dev": false` (no workers.dev duplicate in
      // search) and `"preview_urls": true` (they follow workers_dev otherwise; Previews need them).
      // Non-production branches deploy here as Previews.
      "previews": {},
    },
    "production-preview": {
      "secrets": {
        "required": [
          "SANITY_VIEWER_API_TOKEN",
          "SANITY_EDITOR_API_TOKEN",
          "SHOPIFY_SANITY_SYNC_SECRET",
          "SHOPIFY_PRIVATE_API_TOKEN",
        ],
      },
    },
  },
}
