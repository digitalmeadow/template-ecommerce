{
  "name": "cms",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "pre-gen": "sanity schema validate",
    "gen": "pnpm pre-gen && sanity graphql deploy --force",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate-documents": "tsx --env-file=.env scripts/validateDocuments.mts"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/icons": "5.2.3",
    "@sanity/ui": "4.3.0",
    "@sanity/vision": "6.17.0",
    "frontend": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "6.17.0",
    "sanity-plugin-media": "6.3.2",
    "sanity-plugin-mux-input": "5.1.0",
    "shopify": "workspace:*",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "7.0.0",
    "@types/react": "19.3.0",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "prettier": {
    "semi": true,
    "printWidth": 100,
    "bracketSpacing": true,
    "singleQuote": false
  }
}
